// ---------------------------------------------------------------------------
// APPROVAL WORKFLOW — a single shared capability underneath four separate
// doc requirements that each said "requires approval where configured":
// §24 critical customer profile updates, §36 account holder ownership
// changes, §47/§62 product activation, and AML adjudication (§34). Rather
// than building four bespoke approval mechanisms, every one of them creates
// an ApprovalRequest; approving/rejecting it is a single generic action
// that then applies (or discards) whatever `payload` describes against
// `targetType`/`targetId`. Segregation of duties applies uniformly:
// requestedById and resolvedById can never be the same user.
// ---------------------------------------------------------------------------

enum ApprovalRequestType {
  CUSTOMER_STATUS_CHANGE
  CUSTOMER_PROFILE_UPDATE
  ACCOUNT_HOLDER_ADD
  PRODUCT_ACTIVATION
  AML_ADJUDICATION
  BUSINESS_RULE_ACTIVATION // §41.6 — a rule itself needs authorised approval before going live
  BUSINESS_RULE_TRIGGERED  // a rule's REQUIRE_ADDITIONAL_APPROVAL action fired against a real loan
  LOAN_RESTRUCTURE // doc §72
  LOAN_RESCHEDULE  // doc §73
  LOAN_WRITE_OFF   // doc §74
  COLLECTION_VARIANCE_ADJUSTMENT // doc §82
  COMMISSION_PAYMENT // doc §83
  SAVINGS_RESTRICTION_CREATE  // doc §54
  SAVINGS_RESTRICTION_REMOVE  // doc §54
  CASH_TRANSFER  // doc §114
  CASH_BALANCING_VARIANCE  // doc §115
  JOURNAL_POSTING  // doc §118
  FINANCIAL_PERIOD_REOPEN  // doc §120
  RECURRING_JOURNAL_ACTIVATION  // doc §122
  INTER_BRANCH_TRANSFER  // doc §121
  SALARY_STRUCTURE_CHANGE  // doc §208
  PAYROLL_RUN_APPROVAL  // doc §211

  @@schema("nexus")
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("nexus")
}

model ApprovalRequest {
  id            String                @id(map: "pk_approval_request") @default(uuid())
  institution   Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_approval_request_institution")
  institutionId String                @map("institution_id")
  type          ApprovalRequestType
  status        ApprovalRequestStatus @default(PENDING)

  targetType String  @map("target_type")
  targetId   String  @map("target_id")
  payload    Json
  reason     String?

  requestedById  String    @map("requested_by_id")
  requestedAt    DateTime  @default(now()) @map("requested_at")
  resolvedById   String?   @map("resolved_by_id")
  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
