  guaranteeLimit Decimal    @map("guarantee_limit") @db.Decimal(14, 2) // §65.3 Guarantee Limits — enforced not to exceed the loan principal
  status       GuarantorStatus @default(PENDING)

  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  releasedById String?   @map("released_by_id")
  releasedAt   DateTime? @map("released_at")
  releaseReason String?  @map("release_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("guarantor")
  @@schema("nexus")
}

// doc §66 Collateral Management.
enum CollateralType {
  LAND
  BUILDING
  VEHICLE
  EQUIPMENT
  INVENTORY
  OTHER

  @@schema("nexus")
}

enum CollateralStatus {
  PLEDGED
  RELEASED
  REALISED

  @@schema("nexus")
}

model Collateral {
  id            String           @id(map: "pk_collateral") @default(uuid())
