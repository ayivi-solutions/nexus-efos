  name        String
  description String?
  currency    String  @default("GHS")
  category    String?   @map("product_category") // PDDS §39 — broader classification above LOAN/SAVINGS type
  effectiveTo DateTime? @map("effective_to")       // PDDS §39 — explicit version end-date; null while current

  // Savings-specific (null for LOAN products)
  minOpeningBalance   Decimal? @map("min_opening_balance") @db.Decimal(14, 2)
  minOperatingBalance Decimal? @map("min_operating_balance") @db.Decimal(14, 2)
  maxBalance          Decimal? @map("max_balance") @db.Decimal(14, 2)
  minDeposit          Decimal? @map("min_deposit") @db.Decimal(14, 2)
  maxDeposit          Decimal? @map("max_deposit") @db.Decimal(14, 2)

