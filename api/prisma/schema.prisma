// ---------------------------------------------------------------------------
// APPROVAL WORKFLOW — a single shared capability underneath four separate
// doc requirements that each said "requires approval where configured":
// §24 critical customer profile updates, §36 account holder ownership
// changes, §47/§62 product activation, and AML adjudication (§34). Rather
// than building four bespoke approval mechanisms, every one of them creates
// an ApprovalRequest; approving/rejecting it is a single generic action
// that then applies (or discards) whatever `payload` describes against
// `targetType`/`targetId`. Segregation of duties applies uniformly:
// requestedById and resolvedById can never be the same user.
// ---------------------------------------------------------------------------

enum ApprovalRequestType {
  CUSTOMER_STATUS_CHANGE
  CUSTOMER_PROFILE_UPDATE
  ACCOUNT_HOLDER_ADD
  PRODUCT_ACTIVATION
  AML_ADJUDICATION

  @@schema("nexus")
}

