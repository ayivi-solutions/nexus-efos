// Nexus EFOS — Core Platform schema
// Maps to doc §21 (Layer 1: Core Platform — Enterprise Identity, Security),
// §38 (User Role Architecture), §39 (Permission and Access Control Framework)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["nexus"]
}

// ---------------------------------------------------------------------------
// INSTITUTIONS  (doc §14.3 — Financial Institutions)
// ---------------------------------------------------------------------------

enum InstitutionType {
  INDIVIDUAL_SUSU_OPERATOR
  MICROFINANCE_INSTITUTION
  SAVINGS_AND_LOANS_COMPANY
  CREDIT_UNION
  COOPERATIVE_SOCIETY
  RURAL_COMMUNITY_BANK
  AGENCY_BANKING_NETWORK
  DIGITAL_LENDING_INSTITUTION

  @@schema("nexus")
}

enum InstitutionStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@schema("nexus")
}

model Institution {
  id             String            @id @default(cuid())
  legalName      String
  tradingName    String?
  type           InstitutionType
  status         InstitutionStatus @default(PENDING_ONBOARDING)
  regulatorId    String? // e.g. BoG license / registration number
  country        String            @default("GH")
  region         String?
  phone          String?
  email          String?
  onboardingStep Int               @default(1) // 1..5, drives onboarding wizard

  branches                Branch[]
  users                   User[]
  roles                   Role[]
  customers               Customer[]
  loans                   Loan[]
  savingsAccounts         SavingsAccount[]
  auditLogs               AuditLog[]
  employees               Employee[]
  products                Product[]
  watchlistEntries        WatchlistEntry[]
  accountHolders          AccountHolder[]
  documents               Document[]
  approvalRequests        ApprovalRequest[]
  savingsInterestAccruals SavingsInterestAccrual[]
  savingsInterestPostings SavingsInterestPosting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("institutions")
  @@schema("nexus")
}

model Branch {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  name          String
  code          String
  region        String?
  isHeadOffice  Boolean     @default(false)

  userRoles       UserRole[]
  customers       Customer[]
  loans           Loan[]
  savingsAccounts SavingsAccount[]
  employees       Employee[]

  archived   Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, code])
  @@map("branches")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// USERS  (doc §38.5 — Internal / External user categories)
// ---------------------------------------------------------------------------

enum UserCategory {
  INTERNAL // employees
  EXTERNAL // customers, agents, partners, regulators, developers

  @@schema("nexus")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@schema("nexus")
}

model User {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String

  fullName     String
  email        String
  phone        String?
  passwordHash String
  category     UserCategory @default(INTERNAL)
  status       UserStatus   @default(INVITED)
  mfaEnabled   Boolean      @default(false)

  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  employee      Employee?

  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, email])
  @@map("users")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// RBAC  (doc §38 User Role Architecture, §39 Permission and Access Control)
// ---------------------------------------------------------------------------

enum RoleCategory {
  EXECUTIVE
  OPERATIONAL
  GOVERNANCE
  TECHNICAL
  CUSTOMER

  @@schema("nexus")
}

model Role {
  id            String       @id @default(cuid())
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String? // null = system/global template role
  name          String
  category      RoleCategory
  description   String?
  isSystem      Boolean      @default(false) // seeded template vs institution-defined

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, name])
  @@map("roles")
  @@schema("nexus")
}

// doc §39.6 — Data / Transaction / Administrative / Reporting / Integration
enum PermissionCategory {
  DATA
  TRANSACTION
  ADMINISTRATIVE
  REPORTING
  INTEGRATION

  @@schema("nexus")
}

// doc §38.9 — View, Create, Update, Delete, Approve, Reject, Export, Configure, Administer, Audit
enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
  CONFIGURE
  ADMINISTER
  AUDIT

  @@schema("nexus")
}

model Permission {
  id          String             @id @default(cuid())
  code        String             @unique // e.g. "loans.approve", "users.administer"
  category    PermissionCategory
  action      PermissionAction
  resource    String // e.g. "loans", "savings", "users", "reports"
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("nexus")
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@schema("nexus")
}

// doc §38.12 — Temporary Delegation: time-limited, auto-expiring role assignment
model UserRole {
  id       String  @id @default(cuid())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId   String
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchId String? // resource-level scoping (doc §39.8)

  isDelegated         Boolean   @default(false)
  delegatedFromUserId String?
  startsAt            DateTime  @default(now())
  expiresAt           DateTime? // null = permanent

  createdAt DateTime @default(now())

  @@unique([userId, roleId, branchId])
  @@map("user_roles")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// EMPLOYEE MASTER (doc §50.5 Master Data Domains — "Employee Master:
// Employees, Contract staff, Consultants, Field officers, Executives,
// System users." System access (User) is subordinate to the employee
// record, not the other way around.)
// ---------------------------------------------------------------------------

enum EmploymentStatus {
  ACTIVE
  INACTIVE

  @@schema("nexus")
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  INTERN
  CONSULTANT

  @@schema("nexus")
}

model Employee {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchId      String?

  employeeNumber   String?
  fullName         String
  email            String
  employmentType   EmploymentType @default(PERMANENT)
  department       String?
  division         String?
  position         String?
  grade            String?
  employmentDate   DateTime?
  confirmationDate DateTime?

  reportingManager   Employee?  @relation("ReportingLine", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  reportingManagerId String?
  directReports      Employee[] @relation("ReportingLine")

  status EmploymentStatus @default(ACTIVE)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, email])
  @@unique([institutionId, employeeNumber])
  @@map("employees")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// CUSTOMER LIFECYCLE MANAGEMENT (doc §33)
// ---------------------------------------------------------------------------

enum CustomerSegment {
  INDIVIDUAL
  BUSINESS
  FARMER_GROUP
  WOMENS_GROUP
  YOUTH
  CORPORATE

  @@schema("nexus")
}

enum LifecycleStage {
  AWARENESS
  ACQUISITION
  ONBOARDING
  ACTIVATION
  GROWTH
  RETENTION
  ADVOCACY
  RE_ENGAGEMENT

  @@schema("nexus")
}

// Banking-operational status — distinct axis from LifecycleStage (CRM/
// marketing journey). Gates whether a customer can actually transact
// (Technical Spec sections 26.4, 57.6, 59.6). A customer can be in
// "Retention" from a marketing standpoint while operationally "Dormant".
// Merged from EFS §41.3 (11 values) + Technical Spec §57.6 (9 values) — the
// two documents disagreed on the status set; this reconciles them with
// explicit workflow meaning per value (23 Jul stock-take). PROSPECTIVE
// dropped (no pre-registration lead pipeline exists — a Customer row only
// exists once real registration happens). INACTIVE dropped (a near-
// duplicate of DORMANT with no distinct operational meaning here).
// PENDING_APPROVAL and BLACKLISTED are new, load-bearing additions that
// the approval workflow and AML hard-block below actually depend on.
enum AccountStatus {
  REGISTERED
  PENDING_VERIFICATION
  PENDING_APPROVAL
  VERIFIED
  ACTIVE
  DORMANT
  RESTRICTED
  SUSPENDED
  BLACKLISTED
  CLOSED
  ARCHIVED

  @@schema("nexus")
}

// doc §45.3 Customer Offboarding closure reasons
enum ClosureReason {
  CUSTOMER_REQUEST
  DEATH
  BUSINESS_CLOSURE
  FRAUD
  REGULATORY_DIRECTIVE
  DUPLICATE_MERGE
  MIGRATION
  INACTIVITY
  INSTITUTIONAL_DECISION
  COURT_ORDER
  OTHER

  @@schema("nexus")
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED

  @@schema("nexus")
}

model Customer {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchId      String?

  fullName String
  phone    String
  email    String?
  idType   String?
  idNumber String?

  segment        CustomerSegment @default(INDIVIDUAL)
  lifecycleStage LifecycleStage  @default(ONBOARDING)
  status         AccountStatus   @default(REGISTERED)
  kycStatus      KycStatus       @default(PENDING)

  // Technical Spec §57 — Risk Rating is a Core Attribute; Communication
  // Preferences from doc §39; watchlist/duplicate are review flags, not
  // hard blocks — a screened-positive customer can still be onboarded by
  // an authorised officer after review.
  riskRating        RiskRating?
  preferredChannel  String?
  preferredLanguage String?
  watchlistFlag     Boolean     @default(false)
  possibleDuplicate Boolean     @default(false)

  // doc §39.2 — granular per-channel opt-in/out, replacing the single
  // preferredChannel dropdown as the actual controls (preferredChannel
  // stays as a "primary" hint for UI ordering, not the enforcement point).
  smsEnabled               Boolean @default(true)
  emailEnabled             Boolean @default(true)
  whatsappEnabled          Boolean @default(true)
  marketingEnabled         Boolean @default(false)
  transactionAlertsEnabled Boolean @default(true)
  statementDeliveryEnabled Boolean @default(true)

  // doc §45.3 — closure reason, captured at archive time (was previously
  // not recorded at all).
  closureReason ClosureReason?
  closureNote   String?
  closedById    String?
  closedAt      DateTime?

  archived   Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loans              Loan[]
  savingsAccounts    SavingsAccount[]
  nextOfKin          NextOfKin[]
  notes              CustomerNote[]
  beneficiaries      Beneficiary[]
  beneficialOwners   BeneficialOwner[]
  accountHolderRoles AccountHolder[]
  documents          Document[]

  @@unique([institutionId, phone])
  @@map("customers")
  @@schema("nexus")
}

enum RiskRating {
  LOW
  MEDIUM
  HIGH

  @@schema("nexus")
}

// doc §38 Next of Kin
model NextOfKin {
  id           String   @id @default(cuid())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  fullName     String
  relationship String
  phone        String
  email        String?
  address      String?
  createdAt    DateTime @default(now())

  @@map("next_of_kin")
  @@schema("nexus")
}

// doc §28/§40 — CRM interaction/notes history
model CustomerNote {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  authorId   String?
  note       String
  createdAt  DateTime @default(now())

  @@map("customer_notes")
  @@schema("nexus")
}

// doc §37 Beneficiary Management (savings)
model Beneficiary {
  id            String   @id @default(cuid())
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  fullName      String
  relationship  String
  allocationPct Decimal  @db.Decimal(5, 2)
  phone         String?
  createdAt     DateTime @default(now())

  @@map("beneficiaries")
  @@schema("nexus")
}

// doc §32 Beneficial Ownership (BUSINESS/CORPORATE customers)
model BeneficialOwner {
  id           String   @id @default(cuid())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  fullName     String
  ownershipPct Decimal  @db.Decimal(5, 2)
  idType       String?
  idNumber     String?
  createdAt    DateTime @default(now())

  @@map("beneficial_owners")
  @@schema("nexus")
}

// doc §34 Blacklisting/Watchlist — institution-managed list, screened
// against at customer creation (sets Customer.watchlistFlag for review,
// does not block onboarding outright).
model WatchlistEntry {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  fullName      String
  idNumber      String?
  reason        String?
  addedById     String?
  createdAt     DateTime    @default(now())

  @@map("watchlist_entries")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// APPROVAL WORKFLOW — a single shared capability underneath four separate
// doc requirements that each said "requires approval where configured":
// §24 critical customer profile updates, §36 account holder ownership
// changes, §47/§62 product activation, and AML adjudication (§34). Rather
// than building four bespoke approval mechanisms, every one of them creates
// an ApprovalRequest; approving/rejecting it is a single generic action
// that then applies (or discards) whatever `payload` describes against
// `targetType`/`targetId`. Segregation of duties applies uniformly:
// requestedById and resolvedById can never be the same user.
// ---------------------------------------------------------------------------

enum ApprovalRequestType {
  CUSTOMER_STATUS_CHANGE
  CUSTOMER_PROFILE_UPDATE
  ACCOUNT_HOLDER_ADD
  PRODUCT_ACTIVATION
  AML_ADJUDICATION

  @@schema("nexus")
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("nexus")
}

model ApprovalRequest {
  id            String                @id @default(cuid())
  institution   Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  type          ApprovalRequestType
  status        ApprovalRequestStatus @default(PENDING)

  targetType String
  targetId   String
  payload    Json
  reason     String?

  requestedById  String
  requestedAt    DateTime  @default(now())
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?

  @@map("approval_requests")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// PRODUCTS (Technical Spec §84 — Product Entity Architecture). A Product is
// versioned: every Loan/SavingsAccount locks in the exact ProductVersion it
// was opened under, so revising a product later never silently changes the
// terms of existing accounts. Pragmatic compression: the spec's 7-state
// product lifecycle (Designed/Approved/Published/Active/Suspended/
// Withdrawn/Archived) is collapsed to 4 for a first pass.
// ---------------------------------------------------------------------------

enum ProductType {
  SAVINGS
  LOAN

  @@schema("nexus")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  WITHDRAWN
  ARCHIVED

  @@schema("nexus")
}

model Product {
  id            String        @id @default(cuid())
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  code          String
  type          ProductType
  status        ProductStatus @default(DRAFT)

  versions         ProductVersion[] @relation("AllVersions")
  currentVersion   ProductVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  currentVersionId String?          @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, code])
  @@map("products")
  @@schema("nexus")
}

model ProductVersion {
  id            String  @id @default(cuid())
  product       Product @relation("AllVersions", fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  versionNumber Int

  name        String
  description String?
  currency    String  @default("GHS")

  // Savings-specific (null for LOAN products)
  minOpeningBalance   Decimal? @db.Decimal(14, 2)
  minOperatingBalance Decimal? @db.Decimal(14, 2)
  maxBalance          Decimal? @db.Decimal(14, 2)
  minDeposit          Decimal? @db.Decimal(14, 2)
  maxDeposit          Decimal? @db.Decimal(14, 2)

  // Loan-specific (null for SAVINGS products)
  minLoanAmount   Decimal? @db.Decimal(14, 2)
  maxLoanAmount   Decimal? @db.Decimal(14, 2)
  minTenureMonths Int?
  maxTenureMonths Int?

  interestMethod String  @default("FLAT")
  interestRate   Decimal @db.Decimal(5, 2)
  feeStructure   Json?

  // doc §52.3/§52.4 Savings Interest Management — interestMethod for
  // SAVINGS products additionally takes DAILY_BALANCE, AVERAGE_DAILY_BALANCE,
  // or MINIMUM_MONTHLY_BALANCE (Loan products keep FLAT/REDUCING_BALANCE).
  // interestRateType distinguishes FIXED / TIERED / VARIABLE / PROMOTIONAL —
  // all four named as required functional capabilities, not optional.
  interestRateType  String   @default("FIXED")
  promoInterestRate Decimal? @db.Decimal(6, 3)
  promoDurationDays Int?

  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  currentForProduct Product?           @relation("CurrentVersion")
  loans             Loan[]
  savingsAccounts   SavingsAccount[]
  interestRateTiers InterestRateTier[]

  @@unique([productId, versionNumber])
  @@map("product_versions")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// LOANS (doc §34 Loan Management Service)
// ---------------------------------------------------------------------------

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  ACTIVE
  CLOSED
  DEFAULTED

  @@schema("nexus")
}

model Loan {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchId      String?

  productVersion   ProductVersion? @relation(fields: [productVersionId], references: [id])
  productVersionId String?

  principal      Decimal    @db.Decimal(14, 2)
  interestRate   Decimal    @db.Decimal(5, 2)
  interestMethod String     @default("FLAT")
  termMonths     Int
  status         LoanStatus @default(PENDING)

  initiatedById String?
  approvedById  String?
  disbursedAt   DateTime?

  repayments     LoanRepayment[]
  installments   LoanInstallment[]
  accountHolders AccountHolder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loans")
  @@schema("nexus")
}

model LoanRepayment {
  id           String   @id @default(cuid())
  loan         Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId       String
  amount       Decimal  @db.Decimal(14, 2)
  paidAt       DateTime @default(now())
  recordedById String?

  @@map("loan_repayments")
  @@schema("nexus")
}

// doc §70 Loan Interest Management — the amortization schedule generated at
// disbursement. Repayments allocate against these oldest-first, interest
// before principal within each installment.
enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE

  @@schema("nexus")
}

model LoanInstallment {
  id                String            @id @default(cuid())
  loan              Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId            String
  installmentNumber Int
  dueDate           DateTime
  principalDue      Decimal           @db.Decimal(14, 2)
  interestDue       Decimal           @db.Decimal(14, 2)
  totalDue          Decimal           @db.Decimal(14, 2)
  principalPaid     Decimal           @default(0) @db.Decimal(14, 2)
  interestPaid      Decimal           @default(0) @db.Decimal(14, 2)
  status            InstallmentStatus @default(PENDING)
  createdAt         DateTime          @default(now())

  @@unique([loanId, installmentNumber])
  @@map("loan_installments")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// SAVINGS (doc §34 Savings Account Service, Deposit Processing Service)
// ---------------------------------------------------------------------------

enum SavingsAccountStatus {
  ACTIVE
  DORMANT
  CLOSED

  @@schema("nexus")
}

enum SavingsTxnType {
  DEPOSIT
  WITHDRAWAL
  INTEREST

  @@schema("nexus")
}

model SavingsAccount {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchId      String?

  productVersion   ProductVersion? @relation(fields: [productVersionId], references: [id])
  productVersionId String?

  accountNumber String               @unique
  balance       Decimal              @default(0) @db.Decimal(14, 2)
  ledgerBalance Decimal              @default(0) @db.Decimal(14, 2)
  status        SavingsAccountStatus @default(ACTIVE)

  // doc §52.3 Interest Suspension — accrual pauses without closing the account.
  interestSuspended       Boolean   @default(false)
  interestSuspendedReason String?
  interestSuspendedAt     DateTime?

  // §52.4 Promotional Interest Rates — applied to THIS account instance at
  // opening time from the product's promo configuration, decoupled from the
  // shared product definition so each account's promo window is its own.
  promoInterestRate Decimal?  @db.Decimal(6, 3)
  promoExpiresAt    DateTime?

  lastAccrualDate DateTime?

  transactions     SavingsTransaction[]
  accountHolders   AccountHolder[]
  interestAccruals SavingsInterestAccrual[]
  interestPostings SavingsInterestPosting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("savings_accounts")
  @@schema("nexus")
}

// doc §52 Savings Interest Management, full fidelity.

// §52.4 Tiered Interest Rates — balance-bracket rate structure.
model InterestRateTier {
  id               String         @id @default(cuid())
  productVersion   ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  productVersionId String
  minBalance       Decimal        @db.Decimal(14, 2)
  maxBalance       Decimal?       @db.Decimal(14, 2)
  interestRate     Decimal        @db.Decimal(6, 3)
  createdAt        DateTime       @default(now())

  @@map("interest_rate_tiers")
  @@schema("nexus")
}

// §52.3 Interest Accrual — a real tracked relationship (§59.5), not a
// throwaway live number. Accrual does NOT change balance; only Posting does.
// §52.5 "every posting is auditable" — accrual itself is the audit trail
// for how each posted amount was actually derived, day by day.
model SavingsInterestAccrual {
  id            String         @id @default(cuid())
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  account       SavingsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String
  accrualDate   DateTime
  balanceUsed   Decimal        @db.Decimal(14, 2)
  rateApplied   Decimal        @db.Decimal(6, 3)
  method        String
  amountAccrued Decimal        @db.Decimal(14, 2)
  posted        Boolean        @default(false)
  postingId     String?
  createdAt     DateTime       @default(now())

  @@unique([accountId, accrualDate])
  @@map("savings_interest_accruals")
  @@schema("nexus")
}

// §52.3 Interest Posting + §52.3 Interest Reversal where authorised —
// one row per posting event, whether triggered per-account or as part of
// a batch (§119 Ledger Posting Management supports both patterns).
model SavingsInterestPosting {
  id             String         @id @default(cuid())
  institution    Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId  String
  account        SavingsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId      String
  periodStart    DateTime
  periodEnd      DateTime
  totalAmount    Decimal        @db.Decimal(14, 2)
  transactionId  String?
  batchId        String?
  postedById     String
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  createdAt      DateTime       @default(now())

  @@map("savings_interest_postings")
  @@schema("nexus")
}

// doc §36 Customer Account Linking. Loan/SavingsAccount.customerId remains
// the Primary Account Holder (doc §36.4: "every account has at least one
// primary owner") — this table adds every OTHER relationship type on top,
// without touching any existing primary-ownership code path.
enum AccountHolderRole {
  JOINT
  AUTHORISED_SIGNATORY
  GUARDIAN
  NOMINEE
  POWER_OF_ATTORNEY
  CORPORATE_REPRESENTATIVE

  @@schema("nexus")
}

model AccountHolder {
  id            String            @id @default(cuid())
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  role          AccountHolderRole

  loan             Loan?           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId           String?
  savingsAccount   SavingsAccount? @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)
  savingsAccountId String?

  addedById String?
  createdAt DateTime @default(now())

  @@map("account_holders")
  @@schema("nexus")
}

// doc §30 Customer Document Management, Technical Spec §69 Document Entity
// Architecture. storageReference points into Supabase Storage — the file
// bytes never live in Postgres, only this metadata + integrity checksum.
enum DocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENCE
  VOTER_ID
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  UTILITY_BILL
  PROOF_OF_ADDRESS
  PHOTOGRAPH
  SIGNATURE
  LOAN_DOCUMENT
  CONTRACT
  CONSENT_FORM
  OTHER

  @@schema("nexus")
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  APPROVED
  ACTIVE
  ARCHIVED
  DISPOSED

  @@schema("nexus")
}

model Document {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String?

  documentName     String
  documentType     DocumentType
  category         String?
  storageReference String
  checksum         String
  fileSize         Int
  mimeType         String
  versionNumber    Int            @default(1)
  expiryDate       DateTime?
  status           DocumentStatus @default(UPLOADED)
  uploadedById     String?

  // doc §30.3 "Replace documents... support version history" — Replace
  // creates a new Document row linked back to the one it supersedes, and
  // auto-archives the old one, rather than each upload being independent.
  replacesDocument   Document? @relation("DocumentVersionChain", fields: [replacesDocumentId], references: [id])
  replacesDocumentId String?   @unique
  replacedBy         Document? @relation("DocumentVersionChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
  @@schema("nexus")
}

model SavingsTransaction {
  id           String         @id @default(cuid())
  account      SavingsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId    String
  type         SavingsTxnType
  amount       Decimal        @db.Decimal(14, 2)
  balanceAfter Decimal        @db.Decimal(14, 2)
  recordedById String?
  createdAt    DateTime       @default(now())

  @@map("savings_transactions")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// AUTH SUPPORT
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("refresh_tokens")
  @@schema("nexus")
}

// doc §39.13 — Access Monitoring: every access event should be monitored
model AuditLog {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  action        String // e.g. "auth.login", "role.assign", "loan.approve"
  resource      String?
  resourceId    String?
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime    @default(now())

  @@map("audit_logs")
  @@schema("nexus")
}
