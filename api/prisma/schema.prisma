// ---------------------------------------------------------------------------
// INTERNAL AUDIT — EFS §298 Audit Findings and Recommendation Management,
// the linking piece of §299 Audit Follow-Up (Overdue Action Monitoring),
// and ETAS §78 Audit Entity Architecture (AuditEngagement as aggregate
// root, real lifecycle, real business rules). Ops Supervisor role
// schedule: "Ensure Compliance & Audit done monthly by internal auditor."
//
// Deliberately scoped to findings + remediation tracking, not the full
// §297 Audit Planning and Execution — no audit universe, annual
// risk-based planning, or audit team assignment is built. That's a
// distinct, larger "plan the audit" concern, not what the gap item
// (internal audit findings/remediation tracking) actually names. Named
// as a real, disclosed boundary, not silently dropped.
// ---------------------------------------------------------------------------

enum AuditEngagementType {
  INTERNAL
  EXTERNAL
  REGULATORY
  IT
  FINANCIAL

  @@schema("nexus")
}

// ETAS §78.6 — the real named lifecycle, used as-is.
enum AuditEngagementStatus {
  PLANNED
  APPROVED
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  FOLLOW_UP
  CLOSED
  ARCHIVED

  @@schema("nexus")
}

enum AuditRating {
  SATISFACTORY
  NEEDS_IMPROVEMENT
  UNSATISFACTORY

  @@schema("nexus")
}

// Audit numbers (AUD prefix) generated in internalAudit.routes.ts, same
// pattern as generateJournalNumber/generateComplaintReference/generateComplaintReference.

model AuditEngagement {
  id            String                 @id(map: "pk_audit_engagement") @default(uuid())
  institution   Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_audit_engagement_institution")
  institutionId String                 @map("institution_id")
  branch        Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull, map: "fk_audit_engagement_branch")
  branchId      String?                @map("branch_id") // ETAS §78.4 "Business Unit" — Branch is the closest real scoping concept already in the schema

  auditNumber String              @unique @map("audit_number")
  type        AuditEngagementType
  leadAuditor String              @map("lead_auditor") // free text — an external/regulatory auditor may not be an Employee record
  scope       String // §78.7 "Every audit shall have an approved scope"
  status      AuditEngagementStatus @default(PLANNED)

  plannedStartDate DateTime  @map("planned_start_date")
  completionDate   DateTime? @map("completion_date")
  rating           AuditRating?

  raisedById String   @map("raised_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  findings AuditFinding[]

  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")

  @@index([institutionId, status], map: "idx_audit_engagement_institution_status")
  @@map("audit_engagement")
  @@schema("nexus")
}

enum AuditFindingRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("nexus")
}

// §299.2 "Implementation Verification" is a real, distinct step named
// separately from the recommendation simply being marked done — a
// finding isn't CLOSED just because someone says they fixed it, it needs
// a separate verification.
enum AuditFindingStatus {
  OPEN
  IN_PROGRESS
  IMPLEMENTED
  VERIFIED
  CLOSED

  @@schema("nexus")
}

model AuditFinding {
  id                String          @id(map: "pk_audit_finding") @default(uuid())
  institution       Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_audit_finding_institution")
  institutionId     String          @map("institution_id")
  engagement        AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade, map: "fk_audit_finding_engagement")
  engagementId      String          @map("engagement_id")

  // §298.3 "Every finding receives a unique reference number"
  referenceNumber String           @unique @map("reference_number")
  description     String // §78.7 "Findings shall be supported by documented evidence" — the description is that evidence record; a Document can additionally be attached via the existing Document model's polymorphic-by-convention linkage elsewhere in this codebase, not duplicated here
  riskClassification AuditFindingRisk @map("risk_classification")
  rootCauseAnalysis  String?          @map("root_cause_analysis")
  recommendation     String

  managementResponse String? @map("management_response")
  // §298.3 "Each recommendation has an accountable owner" / ETAS §78.7
  // "Corrective actions shall be assigned before audit closure" —
  // enforced in internalAudit.routes.ts: an engagement cannot move to
  // CLOSED while any of its findings still has actionOwnerId null.
  actionOwner   Employee? @relation(fields: [actionOwnerId], references: [id], onDelete: SetNull, map: "fk_audit_finding_action_owner")
  actionOwnerId String?   @map("action_owner_id")

  targetRemediationDate DateTime? @map("target_remediation_date")
  // §299.2 "Overdue Action Monitoring" — set by the same daily scheduler
  // check that flags overdue complaints, disclosed default logic (past
  // targetRemediationDate, status not yet IMPLEMENTED/VERIFIED/CLOSED),
  // not a configurable rule engine.
  overdue Boolean @default(false)

  status     AuditFindingStatus @default(OPEN)
  verifiedAt   DateTime? @map("verified_at")
  verifiedById String?   @map("verified_by_id")
  closedAt     DateTime? @map("closed_at")
  closedById   String?   @map("closed_by_id")

  raisedById String   @map("raised_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")

  @@index([institutionId, status], map: "idx_audit_finding_institution_status")
  @@map("audit_finding")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// CUSTOMER LIFECYCLE MANAGEMENT (doc §33)
// ---------------------------------------------------------------------------

enum CustomerSegment {
  INDIVIDUAL
  BUSINESS
  FARMER_GROUP
  WOMENS_GROUP
  YOUTH
  CORPORATE

  @@schema("nexus")
}

enum LifecycleStage {
  AWARENESS
  ACQUISITION
  ONBOARDING
  ACTIVATION
  GROWTH
  RETENTION
  ADVOCACY
  RE_ENGAGEMENT

  @@schema("nexus")
}

// Banking-operational status — distinct axis from LifecycleStage (CRM/
// marketing journey). Gates whether a customer can actually transact
// (Technical Spec sections 26.4, 57.6, 59.6). A customer can be in
// "Retention" from a marketing standpoint while operationally "Dormant".
// Merged from EFS §41.3 (11 values) + Technical Spec §57.6 (9 values) — the
// two documents disagreed on the status set; this reconciles them with
// explicit workflow meaning per value (23 Jul stock-take). PROSPECTIVE
// dropped (no pre-registration lead pipeline exists — a Customer row only
// exists once real registration happens). INACTIVE dropped (a near-
// duplicate of DORMANT with no distinct operational meaning here).
// PENDING_APPROVAL and BLACKLISTED are new, load-bearing additions that
// the approval workflow and AML hard-block below actually depend on.
enum AccountStatus {
  REGISTERED
  PENDING_VERIFICATION
  PENDING_APPROVAL
  VERIFIED
  ACTIVE
  DORMANT
  RESTRICTED
  SUSPENDED
  BLACKLISTED
  CLOSED
  ARCHIVED

  @@schema("nexus")
}

// doc §45.3 Customer Offboarding closure reasons
enum RecordStatus {
  ACTIVE
  ARCHIVED
  DELETED

  @@schema("nexus")
}

enum ClosureReason {
  CUSTOMER_REQUEST
  DEATH
  BUSINESS_CLOSURE
  FRAUD
  REGULATORY_DIRECTIVE
  DUPLICATE_MERGE
  MIGRATION
  INACTIVITY
  INSTITUTIONAL_DECISION
  COURT_ORDER
  OTHER

  @@schema("nexus")
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED

  @@schema("nexus")
}

model Customer {
  id            String      @id(map: "pk_customer") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_customer_institution")
  institutionId String      @map("institution_id")
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull, map: "fk_customer_branch")
  branchId      String?     @map("branch_id")

  // doc §23.4 "Create unique customer numbers" / "Capture address
  // information" — both explicitly required by Customer Registration and
  // previously missing entirely, not just unexposed in the UI.
  customerNumber String? @unique @map("customer_number")
  address        String?

  fullName String  @map("full_name")
  phone    String
  email    String?
  idType   String? @map("id_type")
  idNumber String? @map("id_number")

  segment        CustomerSegment @default(INDIVIDUAL)
  lifecycleStage LifecycleStage  @default(ONBOARDING) @map("lifecycle_stage")
  status         AccountStatus   @default(REGISTERED)
  kycStatus      KycStatus       @default(PENDING) @map("kyc_status")

  // Technical Spec §57 — Risk Rating is a Core Attribute; Communication
  // Preferences from doc §39; watchlist/duplicate are review flags, not
  // hard blocks — a screened-positive customer can still be onboarded by
  // an authorised officer after review.
  riskRating        RiskRating? @map("risk_rating")
  preferredChannel  String?     @map("preferred_channel")
  preferredLanguage String?     @map("preferred_language")
  watchlistFlag     Boolean     @default(false) @map("watchlist_flag")
  possibleDuplicate Boolean     @default(false) @map("possible_duplicate")

  // doc §39.2 — granular per-channel opt-in/out, replacing the single
  // preferredChannel dropdown as the actual controls (preferredChannel
  // stays as a "primary" hint for UI ordering, not the enforcement point).
  smsEnabled               Boolean @default(true) @map("sms_enabled")
  emailEnabled             Boolean @default(true) @map("email_enabled")
  whatsappEnabled          Boolean @default(true) @map("whatsapp_enabled")
  marketingEnabled         Boolean @default(false) @map("marketing_enabled")
  transactionAlertsEnabled Boolean @default(true) @map("transaction_alerts_enabled")
  statementDeliveryEnabled Boolean @default(true) @map("statement_delivery_enabled")

  // doc §45.3 — closure reason, captured at archive time (was previously
  // not recorded at all).
  closureReason ClosureReason? @map("closure_reason")
  closureNote   String?        @map("closure_note")
  closedById    String?        @map("closed_by_id")
  closedAt      DateTime?      @map("closed_at")

  // doc §58 Compliance — PEP classification and CDD level. cddLevel is
  // auto-derived (ENHANCED whenever riskRating is HIGH or pepStatus isn't
  // NOT_PEP) rather than independently settable, so it can't silently drift
  // out of sync with the risk factors that are supposed to drive it.
  // Deliberately NOT built here: expiry monitoring or periodic re-screening
  // — both need a job scheduler that doesn't exist in this app yet; naming
  // that honestly rather than half-building an unscheduled "monitor".
  pepStatus       PepStatus @default(NOT_PEP) @map("pep_status")
  cddLevel        CddLevel  @default(STANDARD) @map("cdd_level")
  cddNotes        String?   @map("cdd_notes")
  cddCompletedAt  DateTime? @map("cdd_completed_at")
  cddCompletedById String?  @map("cdd_completed_by_id")

  // Data Migration (§35 Duplicate Management spirit) — tags a customer
  // as having arrived via bulk import rather than organic use, so a bad
  // batch can always be traced and, if needed, identified for cleanup.
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull, map: "fk_customer_import_batch")
  importBatchId String?      @map("import_batch_id")

  archived   Boolean   @default(false)
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  loans              Loan[]
  savingsAccounts    SavingsAccount[]
  nextOfKin          NextOfKin[]
  notes              CustomerNote[]
  beneficiaries      Beneficiary[]
  beneficialOwners   BeneficialOwner[]
  accountHolderRoles AccountHolder[]
  documents          Document[]
  consents           CustomerConsent[]
  mergedInto         CustomerMergeRecord[] @relation("MergedCustomer")
  mergesReceived     CustomerMergeRecord[] @relation("PrimaryCustomer")
  cheques            Cheque[]
  interactions       CustomerInteraction[]
  complaints         CustomerComplaint[]

  // doc §35 — the merge target this customer was consolidated into, if
  // any. Never deleted, only pointed elsewhere and marked MERGED —
  // "Primary customer records remain uniquely identifiable" holds
  // because the merged record itself is preserved, not erased.
  mergedIntoCustomerId String?            @map("merged_into_customer_id")
  mergeStatus          CustomerMergeStatus @default(ACTIVE) @map("merge_status")

  // doc §29.3 Risk Scoring — stored with its breakdown, mirroring the
  // loan credit score's "visible reasoning" pattern (§64).
  kycRiskScore          Int?  @map("kyc_risk_score")
  kycRiskScoreBreakdown Json? @map("kyc_risk_score_breakdown")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([institutionId, phone], map: "uq_customer_institution_id_phone")
  @@map("customer")
  @@schema("nexus")
}

enum PepStatus {
  NOT_PEP
  DOMESTIC_PEP
