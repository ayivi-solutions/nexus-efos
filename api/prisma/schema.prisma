// doc §70 Loan Interest Management — the amortization schedule generated at
// disbursement. Repayments allocate against these oldest-first, interest
// before principal within each installment.
enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE

  @@schema("nexus")
}

model LoanInstallment {
  id                String            @id(map: "pk_loan_installment") @default(uuid())
  loan              Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade, map: "fk_loan_installment_loan")
  loanId            String            @map("loan_id")
  installmentNumber Int               @map("installment_number")
  dueDate           DateTime          @map("due_date")
  principalDue      Decimal           @map("principal_due") @db.Decimal(14, 2)
  interestDue       Decimal           @map("interest_due") @db.Decimal(14, 2)
