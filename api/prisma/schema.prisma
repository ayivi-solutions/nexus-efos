  minTenureMonths Int?     @map("min_tenure_months")
  maxTenureMonths Int?     @map("max_tenure_months")

  interestMethod String  @default("FLAT") @map("interest_method")
  interestRate   Decimal @map("interest_rate") @db.Decimal(5, 2)
  feeStructure   Json?   @map("fee_structure")

  // doc §52.3/§52.4 Savings Interest Management — interestMethod for
  // SAVINGS products additionally takes DAILY_BALANCE, AVERAGE_DAILY_BALANCE,
  // or MINIMUM_MONTHLY_BALANCE (Loan products keep FLAT/REDUCING_BALANCE).
  // interestRateType distinguishes FIXED / TIERED / VARIABLE / PROMOTIONAL —
  // all four named as required functional capabilities, not optional.
  interestRateType  String   @default("FIXED") @map("interest_rate_type")
  promoInterestRate Decimal? @map("promo_interest_rate") @db.Decimal(6, 3)
  promoDurationDays Int?     @map("promo_duration_days")

  effectiveDate DateTime @default(now()) @map("effective_date")
  createdAt     DateTime @default(now()) @map("created_at")

  currentForProduct Product?           @relation("CurrentVersion")
  loans             Loan[]
  savingsAccounts   SavingsAccount[]
  interestRateTiers InterestRateTier[]

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([productId, versionNumber], map: "uq_product_version_product_id_version_number")
  @@map("product_version")
  @@schema("nexus")
}

