  @@map("savings_restriction")
  @@schema("nexus")
}

// doc §58 Standing Instructions. §58.3 lists External Transfers and
// Scheduled Deposits among the named sub-types; neither is buildable here
// honestly — External Transfers need real payment-rail integration (the
// same Tier-3-adjacent gap as Mobile Money/Bank Integration), and a
// "Scheduled Deposit" with no funding source wouldn't be a real deposit,
// just a number appearing from nowhere. What's genuinely executable
// end-to-end within the system today: transfers and repayments between
// accounts that already exist here, and scheduled withdrawals.
enum StandingInstructionType {
  INTERNAL_TRANSFER
  LOAN_REPAYMENT
  SCHEDULED_WITHDRAWAL

  @@schema("nexus")
}

enum StandingInstructionFrequency {
  DAILY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUALLY
  CUSTOM  // doc §122.2 "Custom Schedules" — also usable by Standing Instructions

  @@schema("nexus")
}

enum StandingInstructionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED

  @@schema("nexus")
}

model StandingInstruction {
  id            String      @id(map: "pk_standing_instruction") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_standing_instruction_institution")
  institutionId String      @map("institution_id")

  type                StandingInstructionType
  sourceAccountId     String                       @map("source_account_id")
  destinationAccountId String?                     @map("destination_account_id") // INTERNAL_TRANSFER only
  destinationLoanId   String?                       @map("destination_loan_id") // LOAN_REPAYMENT only
  amount              Decimal                       @db.Decimal(14, 2)
  frequency           StandingInstructionFrequency
  // Only used when frequency is CUSTOM — added alongside Recurring
  // Journal Management (§122), which shares this same frequency enum;
  // without this field, selecting CUSTOM here would silently default to
  // a meaningless 1-day interval.
  customIntervalDays  Int?                          @map("custom_interval_days")
  nextExecutionDate   DateTime                      @map("next_execution_date")
  status              StandingInstructionStatus     @default(ACTIVE)

  // §58.5 "Retry policies are configurable" / "Failed executions
  // generate alerts" — a simple, real retry policy: skip and retry next
  // scheduled run on insufficient balance, auto-suspend after too many
  // consecutive failures rather than retrying forever silently.
  maxRetries          Int @default(3) @map("max_retries")
  consecutiveFailures Int @default(0) @map("consecutive_failures")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  executions StandingInstructionExecution[]

  @@map("standing_instruction")
  @@schema("nexus")
}

enum ExecutionStatus {
  SUCCESS
  FAILED

  @@schema("nexus")
}

model StandingInstructionExecution {
  id           String               @id(map: "pk_si_execution") @default(uuid())
  instruction  StandingInstruction  @relation(fields: [instructionId], references: [id], onDelete: Cascade, map: "fk_si_execution_instruction")
  instructionId String              @map("instruction_id")

  executedAt     DateTime        @default(now()) @map("executed_at")
  status         ExecutionStatus
  amount         Decimal         @db.Decimal(14, 2)
  failureReason  String?         @map("failure_reason")

  @@map("standing_instruction_execution")
  @@schema("nexus")
}

// doc §59 Savings Statements. §59.5 "Historical statements remain
// available" — taken literally: the actual transaction list and computed
// totals are captured as a permanent snapshot at generation time, not
// just a request log. Re-downloading a statement for the same period
// always shows the same figures, even if something about the account
// changes afterward. The PDF itself is regenerated on demand from this
// snapshot rather than stored as a binary blob — no file-storage
// infrastructure needed for this feature specifically.
model SavingsStatement {
  id            String         @id(map: "pk_savings_statement") @default(uuid())
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_savings_statement_institution")
  institutionId String         @map("institution_id")
  account       SavingsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "fk_savings_statement_account")
  accountId     String         @map("account_id")

  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  openingBalance Decimal  @map("opening_balance") @db.Decimal(14, 2)
  closingBalance Decimal  @map("closing_balance") @db.Decimal(14, 2)
  totalInterest  Decimal  @map("total_interest") @db.Decimal(14, 2)
  totalFees      Decimal  @map("total_fees") @db.Decimal(14, 2)
  // §59.5 "Statements reflect only posted transactions" — captured as it
  // genuinely was at generation time.
  transactionSnapshot Json @map("transaction_snapshot")

  generatedById String   @map("generated_by_id")
  generatedAt   DateTime @default(now()) @map("generated_at")

  @@map("savings_statement")
  @@schema("nexus")
}

// doc §111 Cash and Vault Management, §112 Vault Management, §113 Teller
// Management. Cash Transfers (§114) and Balancing/Reconciliation (§115)
// are their own sub-phase, since both depend on Vault and Teller already
// existing.
enum VaultStatus {
  OPEN
  CLOSED

  @@schema("nexus")
}

model Vault {
  id            String      @id(map: "pk_vault") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_vault_institution")
  institutionId String      @map("institution_id")
  branchId      String      @map("branch_id")

  name    String
  balance Decimal     @default(0) @db.Decimal(14, 2)
  status  VaultStatus @default(CLOSED)

  openedById String?   @map("opened_by_id")
  openedAt   DateTime? @map("opened_at")
  closedById String?   @map("closed_by_id")
  closedAt   DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")

  tellers Teller[]

  @@unique([institutionId, branchId, name], map: "uq_vault_institution_branch_name")
  @@map("vault")
  @@schema("nexus")
}

enum TellerStatus {
  ACTIVE
  SUSPENDED

  @@schema("nexus")
}

// A Teller is a role on an existing Employee, matching the same pattern
// as Collector — no duplicate person record.
model Teller {
  id            String       @id(map: "pk_teller") @default(uuid())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_teller_institution")
  institutionId String       @map("institution_id")
  employeeId    String       @unique @map("employee_id")
  vault         Vault?       @relation(fields: [vaultId], references: [id], onDelete: SetNull, map: "fk_teller_vault")
  vaultId       String?      @map("vault_id")

  cashLimit      Decimal      @map("cash_limit") @db.Decimal(14, 2) // §113.3 "Teller cash limits are enforced"
  currentHolding Decimal      @default(0) @map("current_holding") @db.Decimal(14, 2)
  status         TellerStatus @default(ACTIVE)

  suspendedById   String?   @map("suspended_by_id")
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("teller")
  @@schema("nexus")
}

enum CashHolderType {
  VAULT
  TELLER

  @@schema("nexus")
}

enum CashLedgerEntryType {
  RECEIPT
  WITHDRAWAL
  ALLOCATION // vault -> teller at day start
  RETURN     // teller -> vault at day end
  TRANSFER_IN
  TRANSFER_OUT

  @@schema("nexus")
}

// doc §112.2 Cash Receipts/Withdrawals — direct cash movements into or out
// of a vault (e.g. a cash-in-transit delivery, a bank withdrawal run),
// distinct from customer transactions (SavingsTransaction/LoanRepayment)
// and distinct from internal transfers between cash points (§114, its own
// sub-phase, which will also write entries here as TRANSFER_IN/OUT so
// every cash point's full history lives in one place).
model CashLedgerEntry {
  id            String               @id(map: "pk_cash_ledger_entry") @default(uuid())
  institution   Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_cash_ledger_entry_institution")
  institutionId String               @map("institution_id")

  holderType   CashHolderType
  holderId     String               @map("holder_id") // a Vault.id or Teller.id, depending on holderType
  type         CashLedgerEntryType
  amount       Decimal              @db.Decimal(14, 2)
  balanceAfter Decimal              @map("balance_after") @db.Decimal(14, 2)
  notes        String?

  recordedById String   @map("recorded_by_id")
  recordedAt   DateTime @default(now()) @map("recorded_at")

  @@map("cash_ledger_entry")
  @@schema("nexus")
}

// doc §114 Cash Transfer Management. §114.3 "Transfers require
// authorisation" — routes through the existing Approval Workflow.
// "Completed transfers cannot be altered" — no update endpoint exists for
// a COMPLETED transfer, by design, not just by convention.
enum CashTransferStatus {
  PENDING_APPROVAL
  COMPLETED
  REJECTED

  @@schema("nexus")
}

model CashTransfer {
  id            String             @id(map: "pk_cash_transfer") @default(uuid())
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_cash_transfer_institution")
  institutionId String             @map("institution_id")

  fromType CashHolderType @map("from_type")
  fromId   String         @map("from_id")
  toType   CashHolderType @map("to_type")
  toId     String         @map("to_id")

  amount      Decimal            @db.Decimal(14, 2)
  isEmergency Boolean            @default(false) @map("is_emergency")
  reason      String
  status      CashTransferStatus @default(PENDING_APPROVAL)

  requestedById String    @map("requested_by_id")
  approvedById  String?   @map("approved_by_id")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("cash_transfer")
  @@schema("nexus")
}

// doc §115 Cash Balancing and Reconciliation. §115.3 "Adjustments require
// approval" — a variance routes through the existing Approval Workflow,
// same pattern as Collection Settlement (§82).
enum CashBalancingStatus {
  RECONCILED
  VARIANCE_PENDING_APPROVAL

  @@schema("nexus")
}

model CashBalancing {
  id            String               @id(map: "pk_cash_balancing") @default(uuid())
  institution   Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_cash_balancing_institution")
  institutionId String               @map("institution_id")

  holderType     CashHolderType
  holderId       String               @map("holder_id")
  balancingDate  DateTime             @map("balancing_date")
  expectedAmount Decimal              @map("expected_amount") @db.Decimal(14, 2)
  countedAmount  Decimal              @map("counted_amount") @db.Decimal(14, 2)
  variance       Decimal              @db.Decimal(14, 2)
  status         CashBalancingStatus  @default(RECONCILED)
  // §115.3 "Variances are investigated and documented" — required whenever
  // a variance is non-zero, enforced in the route, not just a free field.
  investigationNotes String?          @map("investigation_notes")

  reconciledById String?   @map("reconciled_by_id")
  reconciledAt   DateTime? @map("reconciled_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([holderType, holderId, balancingDate], map: "uq_cash_balancing_holder_date")
  @@map("cash_balancing")
  @@schema("nexus")
}

// doc §117 Chart of Accounts Management, §118 Journal Management, §119
// Ledger Posting Management — the foundational double-entry engine.
// §116.4's full integration (every other module auto-posting into this)
// is a deliberately separate, later increment — this is the engine
// itself, real and standalone, not yet wired to Savings/Loans/Cash-Vault.
enum GLAccountCategory {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE

  @@schema("nexus")
}

enum GLAccountStatus {
  ACTIVE
  INACTIVE

  @@schema("nexus")
}

model GLAccount {
  id            String            @id(map: "pk_gl_account") @default(uuid())
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_gl_account_institution")
  institutionId String            @map("institution_id")

  code     String
  name     String
  category GLAccountCategory
  parent   GLAccount?        @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull, map: "fk_gl_account_parent")
  parentId String?           @map("parent_id")
  children GLAccount[]       @relation("AccountHierarchy")
  currency String            @default("GHS")
  branchId String?           @map("branch_id") // null = institution-wide account
  status   GLAccountStatus   @default(ACTIVE)
  // §117 doesn't literally require a live running balance, but a real
  // ledger without one isn't genuinely useful — maintained on every
  // posting, same discipline as every other balance field in this app.
  balance  Decimal           @default(0) @db.Decimal(16, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  journalLines JournalLine[]
  branchSettlementAccount BranchSettlementAccount?

  @@unique([institutionId, code], map: "uq_gl_account_institution_code")
  @@map("gl_account")
  @@schema("nexus")
}

enum JournalType {
  MANUAL
  AUTOMATIC
  RECURRING
  REVERSING
  ADJUSTMENT

  @@schema("nexus")
}

enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  REJECTED

  @@schema("nexus")
}

// §118.3 "Debits equal credits" is enforced at posting time (see
// lib/generalLedger.ts, tested before it touches a route), not just at
// the UI layer. "Posted journals cannot be deleted" — there is
// deliberately no delete endpoint for a POSTED journal, not just a rule
// nobody happens to break.
model Journal {
  id            String        @id(map: "pk_journal") @default(uuid())
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_journal_institution")
  institutionId String        @map("institution_id")

  journalNumber String        @unique @map("journal_number")
  type          JournalType   @default(MANUAL)
  description   String
  status        JournalStatus @default(DRAFT)
  // doc §120.3 "Closed periods prevent unauthorised postings" — the date
  // that determines which FinancialPeriod this journal belongs to,
  // checked both at creation and again at posting time (see
  // generalLedger.routes.ts and approvals.routes.ts).
  postingDate   DateTime      @default(now()) @map("posting_date")

  // §118.3 "Reversals preserve original journal references"
  reversalOf   Journal?  @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull, map: "fk_journal_reversal_of")
  reversalOfId String?   @map("reversal_of_id")
  reversedBy   Journal[] @relation("JournalReversal")

  postedById String?   @map("posted_by_id")
  postedAt   DateTime? @map("posted_at")
  // Populated whenever a journal is auto-rejected at posting time
  // (imbalance re-check failed, an account went inactive, or its period
  // closed in the gap between drafting and approval) — a silent REJECTED
  // status with no explanation would leave the approver with no idea
  // what actually happened.
  rejectionReason String? @map("rejection_reason")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  lines JournalLine[]

  @@map("journal")
  @@schema("nexus")
}

model JournalLine {
  id        String   @id(map: "pk_journal_line") @default(uuid())
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade, map: "fk_journal_line_journal")
  journalId String   @map("journal_id")
  account   GLAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "fk_journal_line_account")
  accountId String   @map("account_id")

  debit       Decimal @default(0) @db.Decimal(16, 2)
  credit      Decimal @default(0) @db.Decimal(16, 2)
  description String?

  @@map("journal_line")
  @@schema("nexus")
}

// doc §120 Financial Period Management. §120.3 "Closed periods prevent
// unauthorised postings" — genuinely wired into Journal posting (both at
// creation, so a journal can't even be drafted against a closed period,
// and re-checked at approval time, since a period could close in the gap
// between a journal being drafted and its posting being approved).
enum FiscalYearStatus {
  OPEN
  CLOSED

  @@schema("nexus")
}

model FiscalYear {
  id            String           @id(map: "pk_fiscal_year") @default(uuid())
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_fiscal_year_institution")
  institutionId String           @map("institution_id")

  name      String
  startDate DateTime         @map("start_date")
  endDate   DateTime         @map("end_date")
  status    FiscalYearStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")

  periods FinancialPeriod[]

  @@unique([institutionId, name], map: "uq_fiscal_year_institution_name")
  @@map("fiscal_year")
  @@schema("nexus")
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
  LOCKED

  @@schema("nexus")
}

model FinancialPeriod {
  id            String                @id(map: "pk_financial_period") @default(uuid())
  institution   Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_financial_period_institution")
  institutionId String                @map("institution_id")
  fiscalYear    FiscalYear            @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade, map: "fk_financial_period_fiscal_year")
  fiscalYearId  String                @map("fiscal_year_id")

  name      String
  startDate DateTime               @map("start_date")
  endDate   DateTime               @map("end_date")
  status    FinancialPeriodStatus  @default(OPEN)

  closedById  String?   @map("closed_by_id")
  closedAt    DateTime? @map("closed_at")
  reopenedById String?  @map("reopened_by_id")
  reopenedAt   DateTime? @map("reopened_at")
  lockedById   String?  @map("locked_by_id")
  lockedAt     DateTime? @map("locked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("financial_period")
  @@schema("nexus")
}

// doc §122 Recurring Journal Management. §122.3 "Manual overrides require
// authorisation" is read as: the template itself needs authorised
// approval to go live (same Approval Workflow pattern as Business Rules
// activation) — once ACTIVE, each scheduled execution posts automatically
// without per-run approval, since re-approving an already-approved
// recurring pattern every single run would defeat the point of
// automating it.
enum RecurringJournalStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED

  @@schema("nexus")
}

model RecurringJournal {
  id            String                       @id(map: "pk_recurring_journal") @default(uuid())
  institution   Institution                  @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_recurring_journal_institution")
  institutionId String                       @map("institution_id")

  description        String
  // A snapshot of journal lines: [{ accountId, debit, credit, description }]
  lineTemplate        Json                         @map("line_template")
  frequency           StandingInstructionFrequency
  customIntervalDays  Int?                         @map("custom_interval_days")
  nextExecutionDate   DateTime                     @map("next_execution_date")
  status              RecurringJournalStatus       @default(DRAFT)

  maxRetries          Int @default(3) @map("max_retries")
  consecutiveFailures Int @default(0) @map("consecutive_failures")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  executions RecurringJournalExecution[]

  @@map("recurring_journal")
  @@schema("nexus")
}

model RecurringJournalExecution {
  id                 String           @id(map: "pk_recurring_journal_execution") @default(uuid())
  recurringJournal   RecurringJournal @relation(fields: [recurringJournalId], references: [id], onDelete: Cascade, map: "fk_rj_execution_recurring_journal")
  recurringJournalId String           @map("recurring_journal_id")

  executedAt    DateTime        @default(now()) @map("executed_at")
  status        ExecutionStatus
  journalId     String?         @map("journal_id")
  failureReason String?         @map("failure_reason")

  @@map("recurring_journal_execution")
  @@schema("nexus")
}

// doc §121 Inter-Branch Accounting. §121.3 "Inter-branch transactions
// balance automatically" — genuinely true here, not a rule enforced by
// convention: every transfer becomes a single, real 4-line Journal
// (source's real account + source's settlement account, destination's
// real account + destination's settlement account), validated by the
// exact same isBalanced/balanceEffect engine every other journal in the
// app uses. §121.3 "Settlement accounts reconcile correctly" — every
// branch's settlement account balance, summed across the whole
// institution, must net to exactly zero (every Due From has a matching
// Due To somewhere else) — a real, checkable invariant, tested before
// this touched a route.
model BranchSettlementAccount {
  id            String      @id(map: "pk_branch_settlement_account") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_branch_settlement_account_institution")
  institutionId String      @map("institution_id")
  branchId      String      @unique @map("branch_id")
  glAccount     GLAccount   @relation(fields: [glAccountId], references: [id], onDelete: Restrict, map: "fk_branch_settlement_account_gl_account")
  glAccountId   String      @unique @map("gl_account_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("branch_settlement_account")
  @@schema("nexus")
}

enum InterBranchTransferStatus {
  PENDING_APPROVAL
  POSTED
  REJECTED

  @@schema("nexus")
}

model InterBranchTransfer {
  id            String                     @id(map: "pk_inter_branch_transfer") @default(uuid())
  institution   Institution                @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_inter_branch_transfer_institution")
  institutionId String                     @map("institution_id")

  fromBranchId   String  @map("from_branch_id")
  toBranchId     String  @map("to_branch_id")
  fromGLAccountId String @map("from_gl_account_id") // the real account debited/credited at the source (e.g. Cash)
  toGLAccountId   String @map("to_gl_account_id")   // the real account debited/credited at the destination
  amount         Decimal @db.Decimal(14, 2)
  description    String
  status         InterBranchTransferStatus @default(PENDING_APPROVAL)

  journalId     String? @map("journal_id") // set once posted
  requestedById String  @map("requested_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("inter_branch_transfer")
  @@schema("nexus")
}

// doc §206-208 Payroll Management: Overview, Configuration, Salary
// Structure. §212 Statutory Compliance's actual rates are deliberately
// NOT populated here — the schema/structure exists so configuration is
// real infrastructure, not a placeholder, but no PAYE/SSNIT/Tier 2
// calculation happens anywhere in this codebase until the person confirms
// the exact, current, authoritative GRA/SSNIT figures. Building the
// calculation engine against unconfirmed or conflicting rates found via
// web search would risk real financial and legal consequences for real
// employees' pay and the institution's statutory filings.
enum PayFrequency {
  MONTHLY
  BI_WEEKLY
  WEEKLY

  @@schema("nexus")
}

model PayrollCalendar {
  id            String       @id(map: "pk_payroll_calendar") @default(uuid())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_payroll_calendar_institution")
  institutionId String       @map("institution_id")

  name         String
  frequency    PayFrequency
  payDayOfMonth Int?         @map("pay_day_of_month") // for MONTHLY — which calendar day salaries are paid

  createdAt DateTime @default(now()) @map("created_at")

  periods PayrollPeriod[]

  @@map("payroll_calendar")
  @@schema("nexus")
}

enum PayrollPeriodStatus {
  OPEN
  PROCESSING
  PENDING_APPROVAL
  APPROVED
  PAID
  CLOSED

  @@schema("nexus")
}

// §207.3 "Payroll periods cannot overlap" — enforced in the route, same
// discipline as Financial Periods (§120).
model PayrollPeriod {
  id            String              @id(map: "pk_payroll_period") @default(uuid())
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_payroll_period_institution")
  institutionId String              @map("institution_id")
  calendar      PayrollCalendar     @relation(fields: [calendarId], references: [id], onDelete: Restrict, map: "fk_payroll_period_calendar")
  calendarId    String              @map("calendar_id")

  name      String
  startDate DateTime              @map("start_date")
  endDate   DateTime              @map("end_date")
  payDate   DateTime              @map("pay_date")
  status    PayrollPeriodStatus   @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("payroll_period")
  @@schema("nexus")
}

model SalaryGrade {
  id            String      @id(map: "pk_salary_grade") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_salary_grade_institution")
  institutionId String      @map("institution_id")

  name      String
  minSalary Decimal @map("min_salary") @db.Decimal(12, 2)
  maxSalary Decimal @map("max_salary") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([institutionId, name], map: "uq_salary_grade_institution_name")
  @@map("salary_grade")
  @@schema("nexus")
}

model PayGroup {
  id            String      @id(map: "pk_pay_group") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_pay_group_institution")
  institutionId String      @map("institution_id")

  name       String
  calendarId String @map("calendar_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([institutionId, name], map: "uq_pay_group_institution_name")
  @@map("pay_group")
  @@schema("nexus")
}

enum EarningCategory {
  BASIC
  ALLOWANCE
  BONUS
  OVERTIME
  OTHER

  @@schema("nexus")
}

// §209.2's named allowance types (Housing, Transport, Risk, Medical) are
// all just EarningCodes with category=ALLOWANCE — a configurable list,
// not hardcoded enum values, since institutions genuinely differ here.
model EarningCode {
  id            String           @id(map: "pk_earning_code") @default(uuid())
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_earning_code_institution")
  institutionId String           @map("institution_id")

  code     String
  name     String
  category EarningCategory
  // Whether this earning is subject to PAYE — real, load-bearing for the
  // future tax calculation, decided at configuration time per earning
  // type, not assumed uniformly.
  taxable  Boolean          @default(true)
  active   Boolean          @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([institutionId, code], map: "uq_earning_code_institution_code")
  @@map("earning_code")
  @@schema("nexus")
}

enum DeductionCategory {
  STATUTORY
  LOAN
  INSURANCE
  UNION
  OTHER

  @@schema("nexus")
}

model DeductionCode {
  id            String            @id(map: "pk_deduction_code") @default(uuid())
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_deduction_code_institution")
  institutionId String            @map("institution_id")

  code     String
  name     String
  category DeductionCategory
  active   Boolean           @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([institutionId, code], map: "uq_deduction_code_institution_code")
  @@map("deduction_code")
  @@schema("nexus")
}

// §207.2 "Tax Tables" — the real shape (named table, effective date,
// ordered bands with rates) exists so this is genuine infrastructure, but
// deliberately shipped with zero bands populated. No route anywhere
// computes tax from this yet — that's §210/§212, blocked on confirmed
// rates.
model TaxTable {
  id            String      @id(map: "pk_tax_table") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_tax_table_institution")
  institutionId String      @map("institution_id")

  name          String
  effectiveDate DateTime @map("effective_date")
  active        Boolean  @default(false) // deliberately defaults to inactive — nothing should compute from an unconfirmed table

  createdAt DateTime @default(now()) @map("created_at")

  bands TaxBand[]

  @@map("tax_table")
  @@schema("nexus")
}

model TaxBand {
  id         String   @id(map: "pk_tax_band") @default(uuid())
  taxTable   TaxTable @relation(fields: [taxTableId], references: [id], onDelete: Cascade, map: "fk_tax_band_tax_table")
  taxTableId String   @map("tax_table_id")

  sequence   Int
  lowerBound Decimal  @map("lower_bound") @db.Decimal(14, 2)
  upperBound Decimal? @map("upper_bound") // null = no upper bound, the top band
  rate       Decimal  @db.Decimal(5, 2) // a percentage, e.g. 17.50

  @@map("tax_band")
  @@schema("nexus")
}

// §212.2 "Social Security Contributions" / "Pension Contributions" — same
// deliberate non-population as TaxTable, for the same reason.
model StatutoryContributionRate {
  id            String      @id(map: "pk_statutory_contribution_rate") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_statutory_contribution_rate_institution")
  institutionId String      @map("institution_id")

  name          String   // e.g. "SSNIT Employee", "SSNIT Employer", "Tier 2 Employer"
  rate          Decimal  @db.Decimal(5, 2)
  ceiling       Decimal? @db.Decimal(14, 2) // e.g. the SSNIT insurable earnings ceiling, if applicable
  minimum       Decimal? @db.Decimal(14, 2) // e.g. the SSNIT minimum insurable earning floor, if applicable
  effectiveDate DateTime @map("effective_date")
  active        Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("statutory_contribution_rate")
  @@schema("nexus")
}

model OvertimeRule {
  id            String      @id(map: "pk_overtime_rule") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_overtime_rule_institution")
  institutionId String      @map("institution_id")

  name       String
  multiplier Decimal @db.Decimal(4, 2) // e.g. 1.50 for time-and-a-half, 2.00 for double time
  active     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("overtime_rule")
  @@schema("nexus")
}

// doc §208 Salary Structure Management. A new record supersedes the
// previous one rather than editing in place — §208.3 "Historical salary
// records remain available" comes for free from this, the same pattern
// used for Loan Restructuring and Journal reversals.
enum SalaryStructureStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUPERSEDED

  @@schema("nexus")
}

model EmployeeSalaryStructure {
  id            String                 @id(map: "pk_employee_salary_structure") @default(uuid())
  institution   Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_employee_salary_structure_institution")
  institutionId String                 @map("institution_id")

  employeeId    String
  payGroupId    String?  @map("pay_group_id")
  salaryGradeId String?  @map("salary_grade_id")
  basicSalary   Decimal  @map("basic_salary") @db.Decimal(12, 2)
  effectiveDate DateTime @map("effective_date")
  status        SalaryStructureStatus @default(DRAFT)

  createdById  String  @map("created_by_id")
  approvedById String? @map("approved_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  allowances EmployeeAllowance[]
  deductions EmployeeDeduction[]

  @@map("employee_salary_structure")
  @@schema("nexus")
}

model EmployeeAllowance {
  id                        String                  @id(map: "pk_employee_allowance") @default(uuid())
  salaryStructure           EmployeeSalaryStructure @relation(fields: [employeeSalaryStructureId], references: [id], onDelete: Cascade, map: "fk_employee_allowance_salary_structure")
  employeeSalaryStructureId String                  @map("employee_salary_structure_id")
  earningCodeId             String                  @map("earning_code_id")

  amount             Decimal @db.Decimal(12, 2) // a flat amount, or a percentage if isPercentageOfBasic
  isPercentageOfBasic Boolean @default(false) @map("is_percentage_of_basic")

  @@map("employee_allowance")
  @@schema("nexus")
}

// doc §210 Payroll Processing. §210.3 "Duplicate payroll processing is
// prevented" — enforced via a unique constraint on payrollPeriodId, not
// just a route-level check. §210.3 "Payroll processing uses approved
// payroll configurations" — genuinely true: only ACTIVE salary
// structures, ACTIVE tax tables, and ACTIVE statutory rates are ever
// read; nothing DRAFT or inactive can contribute to a real calculation.
enum PayrollRunStatus {
  DRAFT
  PROCESSING
  PROCESSED
  PENDING_APPROVAL
  APPROVED
  PAID
  REVERSED

  @@schema("nexus")
}

model PayrollRun {
  id              String            @id(map: "pk_payroll_run") @default(uuid())
  institution     Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_payroll_run_institution")
  institutionId   String            @map("institution_id")
  payrollPeriodId String            @unique @map("payroll_period_id")

  status          PayrollRunStatus @default(DRAFT)
  totalGross      Decimal          @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalDeductions Decimal          @default(0) @map("total_deductions") @db.Decimal(14, 2)
  totalNet        Decimal          @default(0) @map("total_net") @db.Decimal(14, 2)

  processedById String?   @map("processed_by_id")
  processedAt   DateTime? @map("processed_at")

  // §211.3 "Salary payments occur only after approval" — real gate, not
  // just a label. paidById/paidAt are only ever set once status reaches
  // PAID, which itself is only reachable from APPROVED.
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  paidById     String?   @map("paid_by_id")
  paidAt       DateTime? @map("paid_at")

  reversedById     String?   @map("reversed_by_id")
  reversedAt       DateTime? @map("reversed_at")
  reversalReason   String?   @map("reversal_reason")

  // doc §214 — set the moment each real journal actually posts, not
  // before. accrualJournalId is set at APPROVAL, settlementJournalId at
  // PAID. Both null means neither has posted yet (e.g. no GL mapping
  // configured), which is itself a real, visible, checkable state.
  accrualJournalId    String? @map("accrual_journal_id")
  settlementJournalId String? @map("settlement_journal_id")

  createdAt DateTime @default(now()) @map("created_at")

  entries PayrollEntry[]

  @@map("payroll_run")
  @@schema("nexus")
}

model PayrollEntry {
  id           String     @id(map: "pk_payroll_entry") @default(uuid())
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade, map: "fk_payroll_entry_payroll_run")
  payrollRunId String     @map("payroll_run_id")

  employeeId          String
  basicSalary         Decimal @map("basic_salary") @db.Decimal(12, 2)
  grossPay            Decimal @map("gross_pay") @db.Decimal(12, 2)
  taxableIncome        Decimal @map("taxable_income") @db.Decimal(12, 2)
  paye                Decimal @db.Decimal(12, 2)
  ssnitEmployee       Decimal @map("ssnit_employee") @db.Decimal(12, 2)
  ssnitEmployerTier1  Decimal @map("ssnit_employer_tier1") @db.Decimal(12, 2)
  tier2Employer       Decimal @map("tier2_employer") @db.Decimal(12, 2)
  otherDeductions     Decimal @default(0) @map("other_deductions") @db.Decimal(12, 2)
  netPay              Decimal @map("net_pay") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("payroll_entry")
  @@schema("nexus")
}

// doc §209 Allowance and Deduction Management. EmployeeDeduction mirrors
// EmployeeAllowance exactly — same approval path (via the salary
// structure it belongs to), same flat-or-percentage flexibility. Covers
// Insurance, Union, and Custom deductions fully and really, and Loan
// Deductions as a genuine, manually-entered recurring amount (e.g. a
// staff loan repayment instalment) — NOT automatically tied to a
// tracked staff-loan balance/disbursement/schedule, since no such system
// exists anywhere in this schema. Building an automatic link to customer
// Loans specifically would mean fabricating an Employee-to-Customer
// relationship this platform doesn't have; a full staff-lending module
// (its own disbursement, balance, and repayment-schedule tracking) is
// real, separate, additional scope, named here rather than assumed.
model EmployeeDeduction {
  id                        String                  @id(map: "pk_employee_deduction") @default(uuid())
  salaryStructure           EmployeeSalaryStructure @relation(fields: [employeeSalaryStructureId], references: [id], onDelete: Cascade, map: "fk_employee_deduction_salary_structure")
  employeeSalaryStructureId String                  @map("employee_salary_structure_id")
  deductionCodeId           String                  @map("deduction_code_id")

  amount              Decimal @db.Decimal(12, 2) // a flat amount, or a percentage if isPercentageOfBasic
  isPercentageOfBasic Boolean @default(false) @map("is_percentage_of_basic")
  active              Boolean @default(true) // a deduction can be paused (e.g. a loan fully repaid) without losing its history

  @@map("employee_deduction")
  @@schema("nexus")
}

// doc §214 Payroll Accounting. §214.3 "Payroll journals remain balanced"
// / "Ledger postings occur automatically after approval" / "Every
// accounting entry is audited". Genuine accrual accounting: an accrual
// journal is posted the moment a run is APPROVED (expense + liabilities
// recognized), and a separate settlement journal is posted when the run
// is marked PAID (the salaries-payable liability settled against cash) —
// not one combined journal, since that would conflate two genuinely
// different accounting events. Each GL "purpose" here is matched by
// name, the same pattern already proven for Statutory Contribution
// Rates, rather than a rigid one-to-one schema mapping.
model PayrollGLAccountMapping {
  id            String      @id(map: "pk_payroll_gl_account_mapping") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_payroll_gl_account_mapping_institution")
  institutionId String      @map("institution_id")

  purpose     String // e.g. "Salary Expense", "PAYE Payable", "SSNIT Payable", "Tier 2 Payable", "Employer SSNIT Expense", "Employer Tier 2 Expense", "Other Deductions Payable", "Salaries Payable"
  glAccountId String @map("gl_account_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([institutionId, purpose], map: "uq_payroll_gl_mapping_institution_purpose")
  @@map("payroll_gl_account_mapping")
  @@schema("nexus")
}
