// doc §79 Collector Management, §80 Collection Route Management.
enum CollectorAvailability {
  AVAILABLE
  ON_LEAVE
  SUSPENDED

  @@schema("nexus")
}

// A Collector is a role played by an existing Employee — not a separate
// person record — since every HR field (name, contact, branch) already
// exists on Employee. One collector record per employee.
model Collector {
  id            String                @id(map: "pk_collector") @default(uuid())
  institution   Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_collector_institution")
  institutionId String                @map("institution_id")
  employeeId    String                @unique @map("employee_id")
  branchId      String?               @map("branch_id")
  availability  CollectorAvailability @default(AVAILABLE)

  suspendedById   String?   @map("suspended_by_id")
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")

  createdAt DateTime @default(now()) @map("created_at")

  routes CollectionRoute[]

  @@map("collector")
  @@schema("nexus")
}

model CollectionRoute {
  id            String      @id(map: "pk_collection_route") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_collection_route_institution")
  institutionId String      @map("institution_id")
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull, map: "fk_collection_route_branch")
  branchId      String?     @map("branch_id")

  name        String
  collector   Collector? @relation(fields: [collectorId], references: [id], onDelete: SetNull, map: "fk_collection_route_collector")
  collectorId String?    @map("collector_id")
  isTemporary Boolean    @default(false) @map("is_temporary")
  active      Boolean    @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  customers CollectionRouteCustomer[]

  @@unique([institutionId, name], map: "uq_collection_route_institution_id_name")
  @@map("collection_route")
  @@schema("nexus")
}

// §80.3 "Customers belong to authorised routes" / "Route conflicts are
// prevented" — a customer can only be on one ACTIVE route assignment at a
// time, enforced at the application layer (see routes/collections.routes.ts)
// rather than a DB constraint, since moving a customer between routes is a
// normal, expected operation (old assignment ends, new one begins).
model CollectionRouteCustomer {
  id         String          @id(map: "pk_collection_route_customer") @default(uuid())
  route      CollectionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade, map: "fk_crc_route")
  routeId    String          @map("route_id")
  customerId String          @map("customer_id")
  sequence   Int?
  active     Boolean         @default(true)
  assignedAt DateTime        @default(now()) @map("assigned_at")
  removedAt  DateTime?       @map("removed_at")

  @@map("collection_route_customer")
  @@schema("nexus")
}

// doc §81 Daily Collection Processing. A dedicated transaction record,
// deliberately not reusing the existing savings.initiate-gated deposit
// endpoint or the loan repayment endpoint's internals directly — field
// collectors have their own narrower collections.record permission, and
// duplicating the small, well-understood balance-update logic here is
// safer than refactoring the live, already-working payment endpoints
// under time pressure. Every collection still lands in the exact same
// SavingsTransaction/LoanRepayment tables real payments use, so reporting
// and history are unified regardless of collection channel.
enum CollectionTransactionType {
  SAVINGS_DEPOSIT
  LOAN_REPAYMENT

  @@schema("nexus")
}

enum CollectionTransactionStatus {
  COMPLETED
  REVERSED

  @@schema("nexus")
}

model CollectionTransaction {
  id            String                     @id(map: "pk_collection_transaction") @default(uuid())
  institution   Institution                @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_collection_transaction_institution")
  institutionId String                     @map("institution_id")

  transactionNumber String                     @unique @map("transaction_number")
  type              CollectionTransactionType  @map("type")
  collectorId       String                     @map("collector_id")
  routeId           String?                    @map("route_id")
  customerId        String                     @map("customer_id")
  targetId          String                     @map("target_id") // savingsAccountId or loanId depending on type
  amount            Decimal                    @db.Decimal(14, 2)
  status            CollectionTransactionStatus @default(COMPLETED)

  reversedById     String?   @map("reversed_by_id")
  reversedAt       DateTime? @map("reversed_at")
  reversalReason   String?   @map("reversal_reason")

  collectedAt  DateTime @default(now()) @map("collected_at")
  recordedById String   @map("recorded_by_id")

  @@map("collection_transaction")
  @@schema("nexus")
}

// doc §82 Collection Reconciliation. §82.3 "Adjustments require approval"
// — a variance routes through the existing Approval Workflow rather than
// a bespoke mechanism.
enum SettlementStatus {
  PENDING
  RECONCILED
  VARIANCE_PENDING_APPROVAL

  @@schema("nexus")
}

model CollectionSettlement {
  id            String           @id(map: "pk_collection_settlement") @default(uuid())
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_collection_settlement_institution")
  institutionId String           @map("institution_id")
  collectorId   String           @map("collector_id")

  settlementDate DateTime         @map("settlement_date")
  expectedAmount Decimal          @map("expected_amount") @db.Decimal(14, 2)
  actualAmount   Decimal          @map("actual_amount") @db.Decimal(14, 2)
  variance       Decimal          @db.Decimal(14, 2)
  status         SettlementStatus @default(PENDING)
  notes          String?

  reconciledById String?   @map("reconciled_by_id")
  reconciledAt   DateTime? @map("reconciled_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([collectorId, settlementDate], map: "uq_settlement_collector_date")
  @@map("collection_settlement")
  @@schema("nexus")
}

// doc §83 Commission Management. §83.3 "Approval required before payment"
