// Nexus EFOS — Core Platform schema
// Maps to doc §21 (Layer 1: Core Platform — Enterprise Identity, Security),
// §38 (User Role Architecture), §39 (Permission and Access Control Framework)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["nexus"]
}

// ---------------------------------------------------------------------------
// INSTITUTIONS  (doc §14.3 — Financial Institutions)
// ---------------------------------------------------------------------------

enum InstitutionType {
  INDIVIDUAL_SUSU_OPERATOR
  MICROFINANCE_INSTITUTION
  SAVINGS_AND_LOANS_COMPANY
  CREDIT_UNION
  COOPERATIVE_SOCIETY
  RURAL_COMMUNITY_BANK
  AGENCY_BANKING_NETWORK
  DIGITAL_LENDING_INSTITUTION

  @@schema("nexus")
}

enum InstitutionStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@schema("nexus")
}

model Institution {
  id             String            @id(map: "pk_institution") @default(uuid())
  legalName      String            @map("legal_name")
  tradingName    String?           @map("trading_name")
  type           InstitutionType
  status         InstitutionStatus @default(PENDING_ONBOARDING)
  regulatorId    String?           @map("regulator_id") // e.g. BoG license / registration number
  country        String            @default("GH")
  region         String?
  phone          String?
  email          String?
  onboardingStep Int               @default(1) @map("onboarding_step") // 1..5, drives onboarding wizard

  branches                Branch[]
  users                   User[]
  roles                   Role[]
  customers               Customer[]
  loans                   Loan[]
  savingsAccounts         SavingsAccount[]
  auditLogs               AuditLog[]
  employees               Employee[]
  products                Product[]
  watchlistEntries        WatchlistEntry[]
  accountHolders          AccountHolder[]
  documents               Document[]
  approvalRequests        ApprovalRequest[]
  savingsInterestAccruals SavingsInterestAccrual[]
  savingsInterestPostings SavingsInterestPosting[]
  importBatches           ImportBatch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@map("institution")
  @@schema("nexus")
}

model Branch {
  id            String      @id(map: "pk_branch") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_branch_institution")
  institutionId String      @map("institution_id")
  name          String
  code          String
  region        String?
  isHeadOffice  Boolean     @default(false) @map("is_head_office")

  userRoles       UserRole[]
  customers       Customer[]
  loans           Loan[]
  savingsAccounts SavingsAccount[]
  employees       Employee[]

  archived   Boolean   @default(false)
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([institutionId, code], map: "uq_branch_institution_id_code")
  @@map("branch")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// USERS  (doc §38.5 — Internal / External user categories)
// ---------------------------------------------------------------------------

enum UserCategory {
  INTERNAL // employees
  EXTERNAL // customers, agents, partners, regulators, developers

  @@schema("nexus")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@schema("nexus")
}

model User {
  id            String      @id(map: "pk_user") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_user_institution")
  institutionId String      @map("institution_id")

  fullName     String       @map("full_name")
  email        String
  phone        String?
  passwordHash String       @map("password_hash")
  category     UserCategory @default(INTERNAL)
  status       UserStatus   @default(INVITED)
  mfaEnabled   Boolean      @default(false) @map("mfa_enabled")

  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  employee      Employee?

  inviteToken          String?   @unique @map("invite_token")
  inviteTokenExpiresAt DateTime? @map("invite_token_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([institutionId, email], map: "uq_user_institution_id_email")
  @@map("user")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// RBAC  (doc §38 User Role Architecture, §39 Permission and Access Control)
// ---------------------------------------------------------------------------

enum RoleCategory {
  EXECUTIVE
  OPERATIONAL
  GOVERNANCE
  TECHNICAL
  CUSTOMER

  @@schema("nexus")
}

model Role {
  id            String       @id(map: "pk_role") @default(uuid())
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_role_institution")
  institutionId String?      @map("institution_id") // null = system/global template role
  name          String
  category      RoleCategory
  description   String?
  isSystem      Boolean      @default(false) @map("is_system") // seeded template vs institution-defined

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([institutionId, name], map: "uq_role_institution_id_name")
  @@map("role")
  @@schema("nexus")
}

// doc §39.6 — Data / Transaction / Administrative / Reporting / Integration
enum PermissionCategory {
  DATA
  TRANSACTION
  ADMINISTRATIVE
  REPORTING
  INTEGRATION

  @@schema("nexus")
}

// doc §38.9 — View, Create, Update, Delete, Approve, Reject, Export, Configure, Administer, Audit
enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
  CONFIGURE
  ADMINISTER
  AUDIT

  @@schema("nexus")
}

model Permission {
  id          String             @id(map: "pk_permission") @default(uuid())
  code        String             @unique // e.g. "loans.approve", "users.administer"
  category    PermissionCategory
  action      PermissionAction
  resource    String // e.g. "loans", "savings", "users", "reports"
  description String?

  rolePermissions RolePermission[]

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@map("permission")
  @@schema("nexus")
}

model RolePermission {
  id           String     @id(map: "pk_role_permission") @default(uuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "fk_role_permission_role")
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "fk_role_permission_permission")
  permissionId String     @map("permission_id")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([roleId, permissionId], map: "uq_role_permission_role_id_permission_id")
  @@map("role_permission")
  @@schema("nexus")
}

// doc §38.12 — Temporary Delegation: time-limited, auto-expiring role assignment
model UserRole {
  id       String  @id(map: "pk_user_role") @default(uuid())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_role_user")
  userId   String  @map("user_id")
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "fk_user_role_role")
  roleId   String  @map("role_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull, map: "fk_user_role_branch")
  branchId String? @map("branch_id") // resource-level scoping (doc §39.8)

  isDelegated         Boolean   @default(false) @map("is_delegated")
  delegatedFromUserId String?   @map("delegated_from_user_id")
  startsAt            DateTime  @default(now()) @map("starts_at")
  expiresAt           DateTime? @map("expires_at") // null = permanent

  createdAt DateTime @default(now()) @map("created_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([userId, roleId, branchId], map: "uq_user_role_user_id_role_id_branch_id")
  @@map("user_role")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// EMPLOYEE MASTER (doc §50.5 Master Data Domains — "Employee Master:
// Employees, Contract staff, Consultants, Field officers, Executives,
// System users." System access (User) is subordinate to the employee
// record, not the other way around.)
// ---------------------------------------------------------------------------

enum EmploymentStatus {
  ACTIVE
  INACTIVE

  @@schema("nexus")
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  INTERN
  CONSULTANT

  @@schema("nexus")
}

model Employee {
  id            String      @id(map: "pk_employee") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_employee_institution")
  institutionId String      @map("institution_id")
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull, map: "fk_employee_branch")
  branchId      String?     @map("branch_id")

  employeeNumber   String?        @map("employee_number")
  fullName         String         @map("full_name")
  email            String
  employmentType   EmploymentType @default(PERMANENT) @map("employment_type")
  department       String?
  division         String?
  position         String?
  grade            String?
  employmentDate   DateTime?      @map("employment_date")
  confirmationDate DateTime?      @map("confirmation_date")

  reportingManager   Employee?  @relation("ReportingLine", fields: [reportingManagerId], references: [id], onDelete: SetNull, map: "fk_employee_reporting_manager")
  reportingManagerId String?    @map("reporting_manager_id")
  directReports      Employee[] @relation("ReportingLine")

  status EmploymentStatus @default(ACTIVE)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, map: "fk_employee_user")
  userId String? @unique @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([institutionId, email], map: "uq_employee_institution_id_email")
  @@unique([institutionId, employeeNumber], map: "uq_employee_institution_id_employee_number")
  @@map("employee")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// CUSTOMER LIFECYCLE MANAGEMENT (doc §33)
// ---------------------------------------------------------------------------

enum CustomerSegment {
  INDIVIDUAL
  BUSINESS
  FARMER_GROUP
  WOMENS_GROUP
  YOUTH
  CORPORATE

  @@schema("nexus")
}

enum LifecycleStage {
  AWARENESS
  ACQUISITION
  ONBOARDING
  ACTIVATION
  GROWTH
  RETENTION
  ADVOCACY
  RE_ENGAGEMENT

  @@schema("nexus")
}

// Banking-operational status — distinct axis from LifecycleStage (CRM/
// marketing journey). Gates whether a customer can actually transact
// (Technical Spec sections 26.4, 57.6, 59.6). A customer can be in
// "Retention" from a marketing standpoint while operationally "Dormant".
// Merged from EFS §41.3 (11 values) + Technical Spec §57.6 (9 values) — the
// two documents disagreed on the status set; this reconciles them with
// explicit workflow meaning per value (23 Jul stock-take). PROSPECTIVE
// dropped (no pre-registration lead pipeline exists — a Customer row only
// exists once real registration happens). INACTIVE dropped (a near-
// duplicate of DORMANT with no distinct operational meaning here).
// PENDING_APPROVAL and BLACKLISTED are new, load-bearing additions that
// the approval workflow and AML hard-block below actually depend on.
enum AccountStatus {
  REGISTERED
  PENDING_VERIFICATION
  PENDING_APPROVAL
  VERIFIED
  ACTIVE
  DORMANT
  RESTRICTED
  SUSPENDED
  BLACKLISTED
  CLOSED
  ARCHIVED

  @@schema("nexus")
}

// doc §45.3 Customer Offboarding closure reasons
enum RecordStatus {
  ACTIVE
  ARCHIVED
  DELETED

  @@schema("nexus")
}

enum ClosureReason {
  CUSTOMER_REQUEST
  DEATH
  BUSINESS_CLOSURE
  FRAUD
  REGULATORY_DIRECTIVE
  DUPLICATE_MERGE
  MIGRATION
  INACTIVITY
  INSTITUTIONAL_DECISION
  COURT_ORDER
  OTHER

  @@schema("nexus")
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED

  @@schema("nexus")
}

model Customer {
  id            String      @id(map: "pk_customer") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_customer_institution")
  institutionId String      @map("institution_id")
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull, map: "fk_customer_branch")
  branchId      String?     @map("branch_id")

  fullName String  @map("full_name")
  phone    String
  email    String?
  idType   String? @map("id_type")
  idNumber String? @map("id_number")

  segment        CustomerSegment @default(INDIVIDUAL)
  lifecycleStage LifecycleStage  @default(ONBOARDING) @map("lifecycle_stage")
  status         AccountStatus   @default(REGISTERED)
  kycStatus      KycStatus       @default(PENDING) @map("kyc_status")

  // Technical Spec §57 — Risk Rating is a Core Attribute; Communication
  // Preferences from doc §39; watchlist/duplicate are review flags, not
  // hard blocks — a screened-positive customer can still be onboarded by
  // an authorised officer after review.
  riskRating        RiskRating? @map("risk_rating")
  preferredChannel  String?     @map("preferred_channel")
  preferredLanguage String?     @map("preferred_language")
  watchlistFlag     Boolean     @default(false) @map("watchlist_flag")
  possibleDuplicate Boolean     @default(false) @map("possible_duplicate")

  // doc §39.2 — granular per-channel opt-in/out, replacing the single
  // preferredChannel dropdown as the actual controls (preferredChannel
  // stays as a "primary" hint for UI ordering, not the enforcement point).
  smsEnabled               Boolean @default(true) @map("sms_enabled")
  emailEnabled             Boolean @default(true) @map("email_enabled")
  whatsappEnabled          Boolean @default(true) @map("whatsapp_enabled")
  marketingEnabled         Boolean @default(false) @map("marketing_enabled")
  transactionAlertsEnabled Boolean @default(true) @map("transaction_alerts_enabled")
  statementDeliveryEnabled Boolean @default(true) @map("statement_delivery_enabled")

  // doc §45.3 — closure reason, captured at archive time (was previously
  // not recorded at all).
  closureReason ClosureReason? @map("closure_reason")
  closureNote   String?        @map("closure_note")
  closedById    String?        @map("closed_by_id")
  closedAt      DateTime?      @map("closed_at")

  // doc §58 Compliance — PEP classification and CDD level. cddLevel is
  // auto-derived (ENHANCED whenever riskRating is HIGH or pepStatus isn't
  // NOT_PEP) rather than independently settable, so it can't silently drift
  // out of sync with the risk factors that are supposed to drive it.
  // Deliberately NOT built here: expiry monitoring or periodic re-screening
  // — both need a job scheduler that doesn't exist in this app yet; naming
  // that honestly rather than half-building an unscheduled "monitor".
  pepStatus       PepStatus @default(NOT_PEP) @map("pep_status")
  cddLevel        CddLevel  @default(STANDARD) @map("cdd_level")
  cddNotes        String?   @map("cdd_notes")
  cddCompletedAt  DateTime? @map("cdd_completed_at")
  cddCompletedById String?  @map("cdd_completed_by_id")

  // Data Migration (§35 Duplicate Management spirit) — tags a customer
  // as having arrived via bulk import rather than organic use, so a bad
  // batch can always be traced and, if needed, identified for cleanup.
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull, map: "fk_customer_import_batch")
  importBatchId String?      @map("import_batch_id")

  archived   Boolean   @default(false)
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  loans              Loan[]
  savingsAccounts    SavingsAccount[]
  nextOfKin          NextOfKin[]
  notes              CustomerNote[]
  beneficiaries      Beneficiary[]
  beneficialOwners   BeneficialOwner[]
  accountHolderRoles AccountHolder[]
  documents          Document[]

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([institutionId, phone], map: "uq_customer_institution_id_phone")
  @@map("customer")
  @@schema("nexus")
}

enum PepStatus {
  NOT_PEP
  DOMESTIC_PEP
  FOREIGN_PEP
  PEP_ASSOCIATE

  @@schema("nexus")
}

enum CddLevel {
  STANDARD
  ENHANCED

  @@schema("nexus")
}

enum RiskRating {
  LOW
  MEDIUM
  HIGH

  @@schema("nexus")
}

// doc §38 Next of Kin
model NextOfKin {
  id           String   @id(map: "pk_next_of_kin") @default(uuid())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "fk_next_of_kin_customer")
  customerId   String   @map("customer_id")
  fullName     String   @map("full_name")
  relationship String
  phone        String
  email        String?
  address      String?
  createdAt    DateTime @default(now()) @map("created_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@map("next_of_kin")
  @@schema("nexus")
}

// doc §28/§40 — CRM interaction/notes history
model CustomerNote {
  id         String   @id(map: "pk_customer_note") @default(uuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "fk_customer_note_customer")
  customerId String   @map("customer_id")
  authorId   String?  @map("author_id")
  note       String
