model SavingsFeeType {
  id            String              @id(map: "pk_savings_fee_type") @default(uuid())
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_savings_fee_type_institution")
  institutionId String              @map("institution_id")

  name              String
  category          SavingsFeeCategory
  calculationMethod FeeCalculationMethod @map("calculation_method")
  amount            Decimal              @db.Decimal(14, 2) // a fixed GHS amount or a percentage, per calculationMethod
  productVersionId  String?              @map("product_version_id") // null = applies institution-wide
  active            Boolean              @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  charges SavingsFeeCharge[]

  @@map("savings_fee_type")
  @@schema("nexus")
}

enum FeeChargeStatus {
  APPLIED
  WAIVED
  REVERSED

  @@schema("nexus")
}

// §53.4 "Every fee generates accounting entries" — no General Ledger
// exists yet (Phase 5); this is a real, named gap, not silently ignored.
// Every fee IS fully captured here with its own audit trail in the
// meantime, ready to post once the GL exists.
model SavingsFeeCharge {
  id            String          @id(map: "pk_savings_fee_charge") @default(uuid())
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_savings_fee_charge_institution")
  institutionId String          @map("institution_id")
  account       SavingsAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "fk_savings_fee_charge_account")
  accountId     String          @map("account_id")
  feeType       SavingsFeeType  @relation(fields: [feeTypeId], references: [id], onDelete: Restrict, map: "fk_savings_fee_charge_type")
  feeTypeId     String          @map("fee_type_id")

  amount Decimal         @db.Decimal(14, 2)
  status FeeChargeStatus @default(APPLIED)

  appliedById  String?   @map("applied_by_id")
  appliedAt    DateTime  @default(now()) @map("applied_at")
  waivedById   String?   @map("waived_by_id")
  waivedAt     DateTime? @map("waived_at")
  waivedReason String?   @map("waived_reason")

  @@map("savings_fee_charge")
  @@schema("nexus")
}

// doc §54 Savings Account Restrictions.
enum RestrictionType {
  DEBIT_RESTRICTION
  CREDIT_RESTRICTION
  FULL_FREEZE
  COURT_ORDER
  COMPLIANCE
  FRAUD_INVESTIGATION
  DORMANCY
  CUSTOMER_REQUESTED
  PRODUCT_RESTRICTION
  INSTITUTION_DEFINED

  @@schema("nexus")
}

enum RestrictionStatus {
  PENDING_APPROVAL
  ACTIVE
  REMOVED
  EXPIRED

  @@schema("nexus")
}

// §54.4 "Only authorised users create restrictions" / "removals require
// approval where applicable" — both creation and removal route through
// the Approval Workflow, since freezing or unfreezing someone's account
// is exactly the kind of action that shouldn't rest on one person's say.
model SavingsRestriction {
  id            String             @id(map: "pk_savings_restriction") @default(uuid())
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_savings_restriction_institution")
  institutionId String             @map("institution_id")
  account       SavingsAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "fk_savings_restriction_account")
  accountId     String             @map("account_id")

  type   RestrictionType
  reason String
  status RestrictionStatus @default(PENDING_APPROVAL)

  requestedById String    @map("requested_by_id")
  approvedById  String?   @map("approved_by_id")
  activatedAt   DateTime? @map("activated_at")
  expiresAt     DateTime? @map("expires_at")

  removalRequestedById String?   @map("removal_requested_by_id")
  removedById          String?   @map("removed_by_id")
  removedAt            DateTime? @map("removed_at")
  removalReason        String?   @map("removal_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("savings_restriction")
  @@schema("nexus")
}

// doc §58 Standing Instructions. §58.3 lists External Transfers and
// Scheduled Deposits among the named sub-types; neither is buildable here
// honestly — External Transfers need real payment-rail integration (the
// same Tier-3-adjacent gap as Mobile Money/Bank Integration), and a
// "Scheduled Deposit" with no funding source wouldn't be a real deposit,
// just a number appearing from nowhere. What's genuinely executable
// end-to-end within the system today: transfers and repayments between
// accounts that already exist here, and scheduled withdrawals.
enum StandingInstructionType {
  INTERNAL_TRANSFER
  LOAN_REPAYMENT
  SCHEDULED_WITHDRAWAL

  @@schema("nexus")
}

enum StandingInstructionFrequency {
  DAILY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUALLY
  CUSTOM  // doc §122.2 "Custom Schedules" — also usable by Standing Instructions

  @@schema("nexus")
}

enum StandingInstructionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED

  @@schema("nexus")
}

model StandingInstruction {
  id            String      @id(map: "pk_standing_instruction") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_standing_instruction_institution")
  institutionId String      @map("institution_id")

  type                StandingInstructionType
  sourceAccountId     String                       @map("source_account_id")
  destinationAccountId String?                     @map("destination_account_id") // INTERNAL_TRANSFER only
  destinationLoanId   String?                       @map("destination_loan_id") // LOAN_REPAYMENT only
  amount              Decimal                       @db.Decimal(14, 2)
  frequency           StandingInstructionFrequency
  // Only used when frequency is CUSTOM — added alongside Recurring
  // Journal Management (§122), which shares this same frequency enum;
  // without this field, selecting CUSTOM here would silently default to
  // a meaningless 1-day interval.
  customIntervalDays  Int?                          @map("custom_interval_days")
  nextExecutionDate   DateTime                      @map("next_execution_date")
  status              StandingInstructionStatus     @default(ACTIVE)

  // §58.5 "Retry policies are configurable" / "Failed executions
  // generate alerts" — a simple, real retry policy: skip and retry next
  // scheduled run on insufficient balance, auto-suspend after too many
  // consecutive failures rather than retrying forever silently.
  maxRetries          Int @default(3) @map("max_retries")
  consecutiveFailures Int @default(0) @map("consecutive_failures")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  executions StandingInstructionExecution[]

  @@map("standing_instruction")
  @@schema("nexus")
}

enum ExecutionStatus {
  SUCCESS
  FAILED

  @@schema("nexus")
}

model StandingInstructionExecution {
  id           String               @id(map: "pk_si_execution") @default(uuid())
  instruction  StandingInstruction  @relation(fields: [instructionId], references: [id], onDelete: Cascade, map: "fk_si_execution_instruction")
  instructionId String              @map("instruction_id")

  executedAt     DateTime        @default(now()) @map("executed_at")
  status         ExecutionStatus
  amount         Decimal         @db.Decimal(14, 2)
  failureReason  String?         @map("failure_reason")

  @@map("standing_instruction_execution")
  @@schema("nexus")
}

// doc §59 Savings Statements. §59.5 "Historical statements remain
// available" — taken literally: the actual transaction list and computed
// totals are captured as a permanent snapshot at generation time, not
// just a request log. Re-downloading a statement for the same period
// always shows the same figures, even if something about the account
// changes afterward. The PDF itself is regenerated on demand from this
// snapshot rather than stored as a binary blob — no file-storage
// infrastructure needed for this feature specifically.
model SavingsStatement {
  id            String         @id(map: "pk_savings_statement") @default(uuid())
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_savings_statement_institution")
  institutionId String         @map("institution_id")
  account       SavingsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "fk_savings_statement_account")
  accountId     String         @map("account_id")

  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  openingBalance Decimal  @map("opening_balance") @db.Decimal(14, 2)
  closingBalance Decimal  @map("closing_balance") @db.Decimal(14, 2)
  totalInterest  Decimal  @map("total_interest") @db.Decimal(14, 2)
  totalFees      Decimal  @map("total_fees") @db.Decimal(14, 2)
  // §59.5 "Statements reflect only posted transactions" — captured as it
  // genuinely was at generation time.
  transactionSnapshot Json @map("transaction_snapshot")

  generatedById String   @map("generated_by_id")
  generatedAt   DateTime @default(now()) @map("generated_at")

  @@map("savings_statement")
  @@schema("nexus")
}

// doc §111 Cash and Vault Management, §112 Vault Management, §113 Teller
// Management. Cash Transfers (§114) and Balancing/Reconciliation (§115)
// are their own sub-phase, since both depend on Vault and Teller already
// existing.
enum VaultStatus {
  OPEN
  CLOSED

  @@schema("nexus")
}

model Vault {
  id            String      @id(map: "pk_vault") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_vault_institution")
  institutionId String      @map("institution_id")
  branchId      String      @map("branch_id")

  name    String
  balance Decimal     @default(0) @db.Decimal(14, 2)
  status  VaultStatus @default(CLOSED)

  openedById String?   @map("opened_by_id")
  openedAt   DateTime? @map("opened_at")
  closedById String?   @map("closed_by_id")
  closedAt   DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")

  tellers Teller[]

  @@unique([institutionId, branchId, name], map: "uq_vault_institution_branch_name")
  @@map("vault")
  @@schema("nexus")
}

enum TellerStatus {
  ACTIVE
  SUSPENDED

  @@schema("nexus")
}

// A Teller is a role on an existing Employee, matching the same pattern
// as Collector — no duplicate person record.
model Teller {
  id            String       @id(map: "pk_teller") @default(uuid())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_teller_institution")
  institutionId String       @map("institution_id")
  employeeId    String       @unique @map("employee_id")
  vault         Vault?       @relation(fields: [vaultId], references: [id], onDelete: SetNull, map: "fk_teller_vault")
  vaultId       String?      @map("vault_id")

  cashLimit      Decimal      @map("cash_limit") @db.Decimal(14, 2) // §113.3 "Teller cash limits are enforced"
  currentHolding Decimal      @default(0) @map("current_holding") @db.Decimal(14, 2)
  status         TellerStatus @default(ACTIVE)

  suspendedById   String?   @map("suspended_by_id")
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("teller")
  @@schema("nexus")
}

enum CashHolderType {
  VAULT
  TELLER

  @@schema("nexus")
}

enum CashLedgerEntryType {
  RECEIPT
  WITHDRAWAL
  ALLOCATION // vault -> teller at day start
  RETURN     // teller -> vault at day end
  TRANSFER_IN
  TRANSFER_OUT

  @@schema("nexus")
}

// doc §112.2 Cash Receipts/Withdrawals — direct cash movements into or out
// of a vault (e.g. a cash-in-transit delivery, a bank withdrawal run),
// distinct from customer transactions (SavingsTransaction/LoanRepayment)
// and distinct from internal transfers between cash points (§114, its own
// sub-phase, which will also write entries here as TRANSFER_IN/OUT so
// every cash point's full history lives in one place).
model CashLedgerEntry {
  id            String               @id(map: "pk_cash_ledger_entry") @default(uuid())
  institution   Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_cash_ledger_entry_institution")
  institutionId String               @map("institution_id")

  holderType   CashHolderType
  holderId     String               @map("holder_id") // a Vault.id or Teller.id, depending on holderType
  type         CashLedgerEntryType
  amount       Decimal              @db.Decimal(14, 2)
  balanceAfter Decimal              @map("balance_after") @db.Decimal(14, 2)
  notes        String?

  recordedById String   @map("recorded_by_id")
  recordedAt   DateTime @default(now()) @map("recorded_at")

  @@map("cash_ledger_entry")
  @@schema("nexus")
}

// doc §114 Cash Transfer Management. §114.3 "Transfers require
// authorisation" — routes through the existing Approval Workflow.
// "Completed transfers cannot be altered" — no update endpoint exists for
// a COMPLETED transfer, by design, not just by convention.
enum CashTransferStatus {
  PENDING_APPROVAL
  COMPLETED
  REJECTED

  @@schema("nexus")
}

model CashTransfer {
  id            String             @id(map: "pk_cash_transfer") @default(uuid())
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_cash_transfer_institution")
  institutionId String             @map("institution_id")

  fromType CashHolderType @map("from_type")
  fromId   String         @map("from_id")
  toType   CashHolderType @map("to_type")
  toId     String         @map("to_id")

  amount      Decimal            @db.Decimal(14, 2)
  isEmergency Boolean            @default(false) @map("is_emergency")
  reason      String
  status      CashTransferStatus @default(PENDING_APPROVAL)

  requestedById String    @map("requested_by_id")
  approvedById  String?   @map("approved_by_id")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("cash_transfer")
  @@schema("nexus")
}

// doc §115 Cash Balancing and Reconciliation. §115.3 "Adjustments require
// approval" — a variance routes through the existing Approval Workflow,
// same pattern as Collection Settlement (§82).
enum CashBalancingStatus {
  RECONCILED
  VARIANCE_PENDING_APPROVAL

  @@schema("nexus")
}

model CashBalancing {
  id            String               @id(map: "pk_cash_balancing") @default(uuid())
  institution   Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_cash_balancing_institution")
  institutionId String               @map("institution_id")

  holderType     CashHolderType
  holderId       String               @map("holder_id")
  balancingDate  DateTime             @map("balancing_date")
  expectedAmount Decimal              @map("expected_amount") @db.Decimal(14, 2)
  countedAmount  Decimal              @map("counted_amount") @db.Decimal(14, 2)
  variance       Decimal              @db.Decimal(14, 2)
  status         CashBalancingStatus  @default(RECONCILED)
  // §115.3 "Variances are investigated and documented" — required whenever
  // a variance is non-zero, enforced in the route, not just a free field.
  investigationNotes String?          @map("investigation_notes")

  reconciledById String?   @map("reconciled_by_id")
  reconciledAt   DateTime? @map("reconciled_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([holderType, holderId, balancingDate], map: "uq_cash_balancing_holder_date")
  @@map("cash_balancing")
  @@schema("nexus")
}

// doc: Operations Supervisor role schedule (Neighbourhood Microfinance
// Ltd, June 2026) — "Monitor and confirm outgoing cheques daily and
// during disbursements." That's the concrete trigger, but built as a
// standard, complete cheque register for a financial institution, not
// narrowed to only what that one line names: both directions (a
// customer depositing a cheque is just as real as the institution
// issuing one for a disbursement), and a real clearing lifecycle, since
// any financial institution handling cheques needs both. Not in the ECD/
// EFS/ETAS/PDDS/ESS at all — checked exhaustively (cheque, check,
// clearing, drawee, drawer, payee, post-dated, PDC, dishonour, bounced —
// zero hits across all five documents).
enum ChequeDirection {
  INWARD  // a customer depositing a cheque into their account
  OUTWARD // the institution issuing a cheque (loan disbursement, vendor payment, etc.)

  @@schema("nexus")
}

enum ChequeStatus {
  RECEIVED          // inward: physically received, not yet submitted
  ISSUED            // outward: written/handed out, not yet submitted
  PENDING_CLEARING  // submitted to the bank, awaiting outcome
  CLEARED
  BOUNCED           // dishonoured/returned
  STOPPED           // outward only: payment stopped before clearing
  CANCELLED         // voided before ever being submitted

  @@schema("nexus")
}

model Cheque {
  id            String          @id(map: "pk_cheque") @default(uuid())
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_cheque_institution")
  institutionId String          @map("institution_id")

  direction     ChequeDirection
  chequeNumber  String          @map("cheque_number")
  bankName      String          @map("bank_name") // the drawee bank printed on the cheque
  // The date on the cheque itself, not the date it was recorded here —
  // deliberately a single field, since a post-dated cheque is just one
  // whose chequeDate is in the future; no separate post-dated flag or
  // feature needed.
  chequeDate    DateTime        @map("cheque_date")
  amount        Decimal         @db.Decimal(14, 2)

  payerName     String?         @map("payer_name") // INWARD: who wrote it
  payeeName     String?         @map("payee_name") // OUTWARD: who it's paid to

  status        ChequeStatus    @default(RECEIVED)

  // Linkage is contextual — populated depending on direction, both optional.
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull, map: "fk_cheque_customer")
  customerId       String?         @map("customer_id") // INWARD: whose account it's for
  savingsAccount   SavingsAccount? @relation(fields: [savingsAccountId], references: [id], onDelete: SetNull, map: "fk_cheque_savings_account")
  savingsAccountId String?         @map("savings_account_id")
  loan             Loan?           @relation(fields: [loanId], references: [id], onDelete: SetNull, map: "fk_cheque_loan")
  loanId           String?         @map("loan_id") // OUTWARD: the disbursement this pays out — the doc's named trigger

  clearingSubmittedAt DateTime? @map("clearing_submitted_at")
  clearedAt           DateTime? @map("cleared_at")
  bouncedAt            DateTime? @map("bounced_at")
  bounceReason         String?   @map("bounce_reason")

  // The doc's actual daily task: "monitor and confirm" — a distinct step
  // from status changes, since a cheque can be confirmed (checked,
  // verified as expected) on a given day without its clearing status
  // having changed yet.
  confirmedById String?   @map("confirmed_by_id")
  confirmedAt   DateTime? @map("confirmed_at")

  recordedById String   @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")

  @@unique([institutionId, chequeNumber, bankName, direction], map: "uq_cheque_institution_number_bank_direction")
  @@index([institutionId, status], map: "idx_cheque_institution_status")
  @@map("cheque")
  @@schema("nexus")
}

// doc §117 Chart of Accounts Management, §118 Journal Management, §119
// Ledger Posting Management — the foundational double-entry engine.
// §116.4's full integration (every other module auto-posting into this)
// is a deliberately separate, later increment — this is the engine
// itself, real and standalone, not yet wired to Savings/Loans/Cash-Vault.
enum GLAccountCategory {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE

  @@schema("nexus")
}

// BOG Capital Requirements Directive, 2018 §73 — the three tiers of
// regulatory capital, each with its own admissibility cap relative to
// Risk-Weighted Assets (Additional Tier 1 capped at 1.5% of RWA within
// the Tier 1 minimum, Tier 2 capped at 2.0% of RWA within the Total CAR
// minimum — enforced in lib/capitalAdequacy.ts, not just documented).
enum GLCapitalTier {
  CET1
  ADDITIONAL_TIER1
  TIER2

  @@schema("nexus")
}

enum GLAccountStatus {
  ACTIVE
  INACTIVE

  @@schema("nexus")
}

enum CashFlowActivity {
  OPERATING
  INVESTING
  FINANCING

  @@schema("nexus")
}

model GLAccount {
  id            String            @id(map: "pk_gl_account") @default(uuid())
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_gl_account_institution")
  institutionId String            @map("institution_id")

  code     String
  name     String
  category GLAccountCategory
  parent   GLAccount?        @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull, map: "fk_gl_account_parent")
  parentId String?           @map("parent_id")
  children GLAccount[]       @relation("AccountHierarchy")
  currency String            @default("GHS")
  branchId String?           @map("branch_id") // null = institution-wide account
  status   GLAccountStatus   @default(ACTIVE)
  // §117 doesn't literally require a live running balance, but a real
  // ledger without one isn't genuinely useful — maintained on every
  // posting, same discipline as every other balance field in this app.
  balance  Decimal           @default(0) @db.Decimal(16, 2)

  // doc §BOG Financial Publication Guide — closes the previously-named
  // Cash Flow Statement gap: with each account tagged to a real
  // activity, an indirect-method statement becomes genuinely buildable.
  // Optional and defaults to null — untagged accounts are excluded from
  // the investing/financing sections rather than guessed at, a visible
  // gap rather than a silent misclassification.
  cashFlowActivity CashFlowActivity? @map("cash_flow_activity")
  isLiquidAsset       Boolean @default(false) @map("is_liquid_asset")
  isVolatileLiability Boolean @default(false) @map("is_volatile_liability")

  // Bank of Ghana Capital Requirements Directive, 2018 (uploaded source
  // document) §71-75 — Regulatory Capital composition. Optional and
  // defaults to null, same pattern as isLiquidAsset above: an
  // institution tags its own chart of accounts once (which EQUITY/
  // LIABILITY accounts are CET1 vs Additional Tier 1 vs Tier 2
  // instruments), rather than Claude guessing from account names.
  // Untagged EQUITY accounts are excluded from the capital calculation
  // — a visible, checkable gap, not a silent misclassification.
  capitalTier GLCapitalTier? @map("capital_tier")

  // Same CRD document, Table 2A Risk Weight Categories — for non-loan
  // ASSET accounts (cash, bank balances, fixed assets, government
  // securities, etc.). Loans get their risk weight computed
  // programmatically from real loan data (see lib/capitalAdequacy.ts);
  // this field covers everything else on the balance sheet. Null means
  // "not yet classified" — treated as a conservative disclosed default
  // (100%) in the RWA calculation, flagged in the response rather than
  // silently assumed.
  baselRiskWeightPercent Int? @map("basel_risk_weight_percent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  journalLines JournalLine[]
  branchSettlementAccount BranchSettlementAccount?

  @@unique([institutionId, code], map: "uq_gl_account_institution_code")
  @@map("gl_account")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// CAPITAL ADEQUACY — Banks and Specialised Deposit-Taking Institutions Act,
// 2016 (Act 930) §29: statutory minimum CAR is 10%, BOG may prescribe
// higher/different ratios per institution category (§29(3)) — kept
// configurable here, not hardcoded, for that reason. BOG Capital
// Requirements Directive, 2018 (uploaded source) §71-83 for the full
// CET1/Tier1/Total CAR structure and Capital Conservation Buffer, and
// Table 2A for the Standardised Approach risk-weight categories.
//
// A point-in-time snapshot, not a live-only dashboard number — real
// audit/regulatory practice needs to show what CAR was on a specific
// reporting date without it silently changing if the loan book moves
// later. See lib/capitalAdequacy.ts for the actual computation.
// ---------------------------------------------------------------------------

model RegulatoryCapitalSnapshot {
  id            String      @id(map: "pk_regulatory_capital_snapshot") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_regulatory_capital_snapshot_institution")
  institutionId String      @map("institution_id")

  asOfDate DateTime @map("as_of_date")

  // Raw tier balances from GLAccount.capitalTier-tagged accounts, before
  // the AT1/T2 admissibility caps below are applied.
  rawCet1Capital           Decimal @map("raw_cet1_capital") @db.Decimal(16, 2)
  rawAdditionalTier1Capital Decimal @map("raw_additional_tier1_capital") @db.Decimal(16, 2)
  rawTier2Capital           Decimal @map("raw_tier2_capital") @db.Decimal(16, 2)

  // §73 — AT1 admitted only up to 1.5% of RWA, T2 only up to 2.0% of RWA.
  // These are the actually-admitted figures used in the ratios below.
  admittedAdditionalTier1Capital Decimal @map("admitted_additional_tier1_capital") @db.Decimal(16, 2)
  admittedTier2Capital           Decimal @map("admitted_tier2_capital") @db.Decimal(16, 2)

  totalRWA      Decimal @map("total_rwa") @db.Decimal(16, 2)
  loanRWA       Decimal @map("loan_rwa") @db.Decimal(16, 2)
  otherAssetRWA Decimal @map("other_asset_rwa") @db.Decimal(16, 2)
  // How much of otherAssetRWA came from ASSET accounts with no
  // baselRiskWeightPercent set — the conservative 100% default applied,
  // surfaced so the gap is visible rather than silently absorbed.
  unclassifiedAssetBalance Decimal @map("unclassified_asset_balance") @db.Decimal(16, 2)

  cet1Ratio  Decimal @map("cet1_ratio") @db.Decimal(6, 3)
  tier1Ratio Decimal @map("tier1_ratio") @db.Decimal(6, 3)
  totalCAR   Decimal @map("total_car") @db.Decimal(6, 3)

  // §73/§75 minimums — disclosed defaults from the CRD's own summary
  // table (6.5 / 8.0 / 10.0 / CCB1 3.0), stored per-snapshot rather than
  // hardcoded so a future BOG-prescribed institution-specific ratio
  // (Act 930 §29(3)) can override without a code change.
  minCet1Ratio  Decimal @default(6.5) @map("min_cet1_ratio") @db.Decimal(6, 3)
  minTier1Ratio Decimal @default(8.0) @map("min_tier1_ratio") @db.Decimal(6, 3)
  minCAR        Decimal @default(10.0) @map("min_car") @db.Decimal(6, 3)
  ccb1          Decimal @default(3.0) @map("ccb1") @db.Decimal(6, 3)

  // Standard international NPL definition (loans >90 days past due,
  // matching the CRD §140 past-due threshold) ÷ gross outstanding loans.
  // nplCeiling default 5.0 is a real, dated, current regulatory figure —
  // BOG Governor's directive, reported 5 Aug 2026, requiring microfinance
  // firms specifically to hold NPLs to no more than 5% by Dec 2026 (the
  // general SDI/bank ceiling is 10%) — not an invented default.
  nplRatio   Decimal @map("npl_ratio") @db.Decimal(6, 3)
  nplCeiling Decimal @default(5.0) @map("npl_ceiling") @db.Decimal(6, 3)

  // Full line-item breakdown (per-category RWA, per-tier capital
  // components, loan classification counts) for audit/reporting —
  // deliberately not normalized into more tables, same pattern as
  // SavingsStatement.transactionSnapshot.
  breakdown Json

  computedById String?  @map("computed_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")

  @@index([institutionId, asOfDate], map: "idx_regulatory_capital_snapshot_institution_date")
  @@map("regulatory_capital_snapshot")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS — EFS §249 External Service Connectors names SMS/Email
// Providers as required categories with real business rules (connectors
// configurable, credentials encrypted, connection failures generate
// alerts, every connector transaction audited) but no vendor. GM chose:
// Resend (email), Hubtel (SMS), Meta WhatsApp Cloud API directly (Hubtel's
// WhatsApp offering isn't in their public docs the way SMS is — Meta's
// Cloud API is the well-documented, standard path underneath virtually
// every WhatsApp Business integration, including likely Hubtel's own).
//
// Closes a real, quietly-accumulating gap: CustomerComplaint and other
// modules have been recording customerNotifiedAt as an audit fact with
// no actual message ever sent — this is the piece that makes it real.
// ---------------------------------------------------------------------------

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP

  @@schema("nexus")
}

// One row per institution per channel — credentials encrypted at rest
// with the same AES-256-GCM helper already used for MFA secrets
// (lib/security.ts), not a new mechanism.
model NotificationProviderConfig {
  id            String              @id(map: "pk_notification_provider_config") @default(uuid())
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_notification_provider_config_institution")
  institutionId String              @map("institution_id")

  channel  NotificationChannel
  provider String // "resend" | "hubtel" | "meta_whatsapp" — a string, not an enum, so a future provider swap doesn't need a migration
  // Provider-specific: Resend api key; Hubtel clientId/clientSecret/senderId;
  // Meta phoneNumberId/accessToken. Stored as one encrypted JSON blob via
  // encryptSecret — same reasoning as UserMfa.secretEncrypted: never
  // plaintext, self-contained (iv+authTag+ciphertext), one decrypt call.
  credentialsEncrypted String @map("credentials_encrypted")
  senderId              String? @map("sender_id") // SMS sender name / verified email from-address / WhatsApp phone number ID, whichever applies
  active                Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")

  @@unique([institutionId, channel], map: "uq_notification_provider_config_institution_channel")
  @@map("notification_provider_config")
  @@schema("nexus")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@schema("nexus")
}

// The audit trail §249.3 requires ("every connector transaction is
// audited") — every send attempt, not just successful ones, so a
// failure is visible and queryable, not silently swallowed.
model Notification {
  id            String              @id(map: "pk_notification") @default(uuid())
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_notification_institution")
  institutionId String              @map("institution_id")

  channel   NotificationChannel
  recipient String // phone number or email address
  subject   String? // email only
  body      String // rendered message text; for WHATSAPP this is the human-readable summary, not necessarily what Meta requires (see templateName)
  templateName     String? @map("template_name") // WhatsApp only — Meta requires a pre-approved template name for business-initiated messages outside a live 24h conversation window
  templateLanguage String? @map("template_language")

  status         NotificationStatus @default(PENDING)
  providerMessageId String? @map("provider_message_id")
  errorMessage       String? @map("error_message")

  // Polymorphic link to whatever triggered this — a CustomerComplaint,
  // an AuditFinding, etc. — by convention (resourceType/resourceId), same
  // pattern AuditLog already uses, not a new one.
  relatedResourceType String? @map("related_resource_type")
  relatedResourceId   String? @map("related_resource_id")

  sentById String? @map("sent_by_id") // null when sent by a scheduler/system process, not a person
  createdAt DateTime @default(now()) @map("created_at")

  @@index([institutionId, status], map: "idx_notification_institution_status")
  @@index([institutionId, relatedResourceType, relatedResourceId], map: "idx_notification_institution_resource")
  @@map("notification")
  @@schema("nexus")
}

enum JournalType {
  MANUAL
  AUTOMATIC
  RECURRING
  REVERSING
  ADJUSTMENT

  @@schema("nexus")
}

enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  REJECTED

  @@schema("nexus")
}

// §118.3 "Debits equal credits" is enforced at posting time (see
// lib/generalLedger.ts, tested before it touches a route), not just at
// the UI layer. "Posted journals cannot be deleted" — there is
// deliberately no delete endpoint for a POSTED journal, not just a rule
// nobody happens to break.
model Journal {
  id            String        @id(map: "pk_journal") @default(uuid())
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_journal_institution")
  institutionId String        @map("institution_id")

  journalNumber String        @unique @map("journal_number")
  type          JournalType   @default(MANUAL)
  description   String
  status        JournalStatus @default(DRAFT)
  // doc §120.3 "Closed periods prevent unauthorised postings" — the date
  // that determines which FinancialPeriod this journal belongs to,
  // checked both at creation and again at posting time (see
  // generalLedger.routes.ts and approvals.routes.ts).
  postingDate   DateTime      @default(now()) @map("posting_date")

  // §118.3 "Reversals preserve original journal references"
  reversalOf   Journal?  @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull, map: "fk_journal_reversal_of")
  reversalOfId String?   @map("reversal_of_id")
  reversedBy   Journal[] @relation("JournalReversal")

  postedById String?   @map("posted_by_id")
  postedAt   DateTime? @map("posted_at")
  // Populated whenever a journal is auto-rejected at posting time
  // (imbalance re-check failed, an account went inactive, or its period
  // closed in the gap between drafting and approval) — a silent REJECTED
  // status with no explanation would leave the approver with no idea
  // what actually happened.
  rejectionReason String? @map("rejection_reason")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  lines JournalLine[]

  @@map("journal")
  @@schema("nexus")
}

model JournalLine {
  id        String   @id(map: "pk_journal_line") @default(uuid())
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade, map: "fk_journal_line_journal")
  journalId String   @map("journal_id")
  account   GLAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "fk_journal_line_account")
  accountId String   @map("account_id")

  debit       Decimal @default(0) @db.Decimal(16, 2)
  credit      Decimal @default(0) @db.Decimal(16, 2)
  description String?

  @@map("journal_line")
  @@schema("nexus")
}

// doc §120 Financial Period Management. §120.3 "Closed periods prevent
// unauthorised postings" — genuinely wired into Journal posting (both at
// creation, so a journal can't even be drafted against a closed period,
// and re-checked at approval time, since a period could close in the gap
// between a journal being drafted and its posting being approved).
enum FiscalYearStatus {
  OPEN
  CLOSED

  @@schema("nexus")
}

model FiscalYear {
  id            String           @id(map: "pk_fiscal_year") @default(uuid())
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_fiscal_year_institution")
  institutionId String           @map("institution_id")

  name      String
  startDate DateTime         @map("start_date")
  endDate   DateTime         @map("end_date")
  status    FiscalYearStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")

  periods FinancialPeriod[]

  @@unique([institutionId, name], map: "uq_fiscal_year_institution_name")
  @@map("fiscal_year")
  @@schema("nexus")
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
  LOCKED

  @@schema("nexus")
}

model FinancialPeriod {
  id            String                @id(map: "pk_financial_period") @default(uuid())
  institution   Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_financial_period_institution")
  institutionId String                @map("institution_id")
  fiscalYear    FiscalYear            @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade, map: "fk_financial_period_fiscal_year")
  fiscalYearId  String                @map("fiscal_year_id")

  name      String
  startDate DateTime               @map("start_date")
  endDate   DateTime               @map("end_date")
  status    FinancialPeriodStatus  @default(OPEN)

  closedById  String?   @map("closed_by_id")
  closedAt    DateTime? @map("closed_at")
  reopenedById String?  @map("reopened_by_id")
  reopenedAt   DateTime? @map("reopened_at")
  lockedById   String?  @map("locked_by_id")
  lockedAt     DateTime? @map("locked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("financial_period")
  @@schema("nexus")
}

// doc §122 Recurring Journal Management. §122.3 "Manual overrides require
// authorisation" is read as: the template itself needs authorised
// approval to go live (same Approval Workflow pattern as Business Rules
// activation) — once ACTIVE, each scheduled execution posts automatically
// without per-run approval, since re-approving an already-approved
// recurring pattern every single run would defeat the point of
// automating it.
enum RecurringJournalStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED

  @@schema("nexus")
}

model RecurringJournal {
  id            String                       @id(map: "pk_recurring_journal") @default(uuid())
  institution   Institution                  @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_recurring_journal_institution")
  institutionId String                       @map("institution_id")

  description        String
  // A snapshot of journal lines: [{ accountId, debit, credit, description }]
  lineTemplate        Json                         @map("line_template")
  frequency           StandingInstructionFrequency
  customIntervalDays  Int?                         @map("custom_interval_days")
  nextExecutionDate   DateTime                     @map("next_execution_date")
  status              RecurringJournalStatus       @default(DRAFT)

  maxRetries          Int @default(3) @map("max_retries")
  consecutiveFailures Int @default(0) @map("consecutive_failures")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  executions RecurringJournalExecution[]

  @@map("recurring_journal")
  @@schema("nexus")
}

model RecurringJournalExecution {
  id                 String           @id(map: "pk_recurring_journal_execution") @default(uuid())
  recurringJournal   RecurringJournal @relation(fields: [recurringJournalId], references: [id], onDelete: Cascade, map: "fk_rj_execution_recurring_journal")
  recurringJournalId String           @map("recurring_journal_id")

  executedAt    DateTime        @default(now()) @map("executed_at")
  status        ExecutionStatus
  journalId     String?         @map("journal_id")
  failureReason String?         @map("failure_reason")

  @@map("recurring_journal_execution")
  @@schema("nexus")
}

// doc §121 Inter-Branch Accounting. §121.3 "Inter-branch transactions
// balance automatically" — genuinely true here, not a rule enforced by
// convention: every transfer becomes a single, real 4-line Journal
// (source's real account + source's settlement account, destination's
// real account + destination's settlement account), validated by the
// exact same isBalanced/balanceEffect engine every other journal in the
// app uses. §121.3 "Settlement accounts reconcile correctly" — every
// branch's settlement account balance, summed across the whole
// institution, must net to exactly zero (every Due From has a matching
// Due To somewhere else) — a real, checkable invariant, tested before
// this touched a route.
model BranchSettlementAccount {
  id            String      @id(map: "pk_branch_settlement_account") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_branch_settlement_account_institution")
  institutionId String      @map("institution_id")
  branchId      String      @unique @map("branch_id")
  glAccount     GLAccount   @relation(fields: [glAccountId], references: [id], onDelete: Restrict, map: "fk_branch_settlement_account_gl_account")
  glAccountId   String      @unique @map("gl_account_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("branch_settlement_account")
  @@schema("nexus")
}

enum InterBranchTransferStatus {
  PENDING_APPROVAL
  POSTED
  REJECTED

  @@schema("nexus")
}

model InterBranchTransfer {
  id            String                     @id(map: "pk_inter_branch_transfer") @default(uuid())
  institution   Institution                @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_inter_branch_transfer_institution")
  institutionId String                     @map("institution_id")

  fromBranchId   String  @map("from_branch_id")
  toBranchId     String  @map("to_branch_id")
  fromGLAccountId String @map("from_gl_account_id") // the real account debited/credited at the source (e.g. Cash)
  toGLAccountId   String @map("to_gl_account_id")   // the real account debited/credited at the destination
  amount         Decimal @db.Decimal(14, 2)
  description    String
  status         InterBranchTransferStatus @default(PENDING_APPROVAL)

  journalId     String? @map("journal_id") // set once posted
  requestedById String  @map("requested_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("inter_branch_transfer")
  @@schema("nexus")
}

// doc §206-208 Payroll Management: Overview, Configuration, Salary
// Structure. §212 Statutory Compliance's actual rates are deliberately
// NOT populated here — the schema/structure exists so configuration is
// real infrastructure, not a placeholder, but no PAYE/SSNIT/Tier 2
// calculation happens anywhere in this codebase until the person confirms
// the exact, current, authoritative GRA/SSNIT figures. Building the
// calculation engine against unconfirmed or conflicting rates found via
// web search would risk real financial and legal consequences for real
// employees' pay and the institution's statutory filings.
enum PayFrequency {
  MONTHLY
  BI_WEEKLY
  WEEKLY

  @@schema("nexus")
}

model PayrollCalendar {
  id            String       @id(map: "pk_payroll_calendar") @default(uuid())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_payroll_calendar_institution")
  institutionId String       @map("institution_id")

  name         String
  frequency    PayFrequency
  payDayOfMonth Int?         @map("pay_day_of_month") // for MONTHLY — which calendar day salaries are paid

  createdAt DateTime @default(now()) @map("created_at")

  periods PayrollPeriod[]

  @@map("payroll_calendar")
  @@schema("nexus")
}

enum PayrollPeriodStatus {
  OPEN
  PROCESSING
  PENDING_APPROVAL
  APPROVED
  PAID
  CLOSED

  @@schema("nexus")
}

// §207.3 "Payroll periods cannot overlap" — enforced in the route, same
// discipline as Financial Periods (§120).
model PayrollPeriod {
  id            String              @id(map: "pk_payroll_period") @default(uuid())
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_payroll_period_institution")
  institutionId String              @map("institution_id")
  calendar      PayrollCalendar     @relation(fields: [calendarId], references: [id], onDelete: Restrict, map: "fk_payroll_period_calendar")
  calendarId    String              @map("calendar_id")

  name      String
  startDate DateTime              @map("start_date")
  endDate   DateTime              @map("end_date")
  payDate   DateTime              @map("pay_date")
  status    PayrollPeriodStatus   @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("payroll_period")
  @@schema("nexus")
}

model SalaryGrade {
  id            String      @id(map: "pk_salary_grade") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_salary_grade_institution")
  institutionId String      @map("institution_id")

  name      String
  minSalary Decimal @map("min_salary") @db.Decimal(12, 2)
  maxSalary Decimal @map("max_salary") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([institutionId, name], map: "uq_salary_grade_institution_name")
  @@map("salary_grade")
  @@schema("nexus")
}

model PayGroup {
  id            String      @id(map: "pk_pay_group") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_pay_group_institution")
  institutionId String      @map("institution_id")

  name       String
  calendarId String @map("calendar_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([institutionId, name], map: "uq_pay_group_institution_name")
  @@map("pay_group")
  @@schema("nexus")
}

enum EarningCategory {
  BASIC
  ALLOWANCE
  BONUS
  OVERTIME
  OTHER

  @@schema("nexus")
}

// §209.2's named allowance types (Housing, Transport, Risk, Medical) are
// all just EarningCodes with category=ALLOWANCE — a configurable list,
// not hardcoded enum values, since institutions genuinely differ here.
model EarningCode {
  id            String           @id(map: "pk_earning_code") @default(uuid())
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_earning_code_institution")
  institutionId String           @map("institution_id")

  code     String
  name     String
  category EarningCategory
  // Whether this earning is subject to PAYE — real, load-bearing for the
  // future tax calculation, decided at configuration time per earning
  // type, not assumed uniformly.
  taxable  Boolean          @default(true)
  active   Boolean          @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([institutionId, code], map: "uq_earning_code_institution_code")
  @@map("earning_code")
  @@schema("nexus")
}

enum DeductionCategory {
  STATUTORY
  LOAN
  INSURANCE
  UNION
  OTHER

  @@schema("nexus")
}

model DeductionCode {
  id            String            @id(map: "pk_deduction_code") @default(uuid())
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_deduction_code_institution")
  institutionId String            @map("institution_id")

  code     String
  name     String
  category DeductionCategory
  active   Boolean           @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([institutionId, code], map: "uq_deduction_code_institution_code")
  @@map("deduction_code")
  @@schema("nexus")
