  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")

  @@unique([institutionId, title], map: "uq_position_institution_id_title")
  @@map("position")
  @@schema("nexus")
}

// doc §77 Loan Arrears Management + §71 Loan Penalty Management.
