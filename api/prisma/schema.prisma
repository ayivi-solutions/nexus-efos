// doc §208 Salary Structure Management. A new record supersedes the
// previous one rather than editing in place — §208.3 "Historical salary
// records remain available" comes for free from this, the same pattern
// used for Loan Restructuring and Journal reversals.
enum SalaryStructureStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUPERSEDED

  @@schema("nexus")
}

model EmployeeSalaryStructure {
  id            String                 @id(map: "pk_employee_salary_structure") @default(uuid())
  institution   Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_employee_salary_structure_institution")
  institutionId String                 @map("institution_id")

  employeeId    String
  payGroupId    String?  @map("pay_group_id")
  salaryGradeId String?  @map("salary_grade_id")
  basicSalary   Decimal  @map("basic_salary") @db.Decimal(12, 2)
  effectiveDate DateTime @map("effective_date")
  status        SalaryStructureStatus @default(DRAFT)

  createdById  String  @map("created_by_id")
  approvedById String? @map("approved_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  allowances EmployeeAllowance[]
  deductions EmployeeDeduction[]

  @@map("employee_salary_structure")
  @@schema("nexus")
}

model EmployeeAllowance {
  id                        String                  @id(map: "pk_employee_allowance") @default(uuid())
  salaryStructure           EmployeeSalaryStructure @relation(fields: [employeeSalaryStructureId], references: [id], onDelete: Cascade, map: "fk_employee_allowance_salary_structure")
  employeeSalaryStructureId String                  @map("employee_salary_structure_id")
  earningCodeId             String                  @map("earning_code_id")

  amount             Decimal @db.Decimal(12, 2) // a flat amount, or a percentage if isPercentageOfBasic
  isPercentageOfBasic Boolean @default(false) @map("is_percentage_of_basic")

  @@map("employee_allowance")
  @@schema("nexus")
}

// doc §210 Payroll Processing. §210.3 "Duplicate payroll processing is
// prevented" — enforced via a unique constraint on payrollPeriodId, not
// just a route-level check. §210.3 "Payroll processing uses approved
// payroll configurations" — genuinely true: only ACTIVE salary
// structures, ACTIVE tax tables, and ACTIVE statutory rates are ever
// read; nothing DRAFT or inactive can contribute to a real calculation.
enum PayrollRunStatus {
  DRAFT
  PROCESSING
  PROCESSED
  PENDING_APPROVAL
  APPROVED
  PAID
  REVERSED

  @@schema("nexus")
}

model PayrollRun {
  id              String            @id(map: "pk_payroll_run") @default(uuid())
  institution     Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_payroll_run_institution")
  institutionId   String            @map("institution_id")
  payrollPeriodId String            @unique @map("payroll_period_id")

  status          PayrollRunStatus @default(DRAFT)
  totalGross      Decimal          @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalDeductions Decimal          @default(0) @map("total_deductions") @db.Decimal(14, 2)
  totalNet        Decimal          @default(0) @map("total_net") @db.Decimal(14, 2)

  processedById String?   @map("processed_by_id")
  processedAt   DateTime? @map("processed_at")

  // §211.3 "Salary payments occur only after approval" — real gate, not
  // just a label. paidById/paidAt are only ever set once status reaches
  // PAID, which itself is only reachable from APPROVED.
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  paidById     String?   @map("paid_by_id")
  paidAt       DateTime? @map("paid_at")

  reversedById     String?   @map("reversed_by_id")
  reversedAt       DateTime? @map("reversed_at")
  reversalReason   String?   @map("reversal_reason")

  // doc §214 — set the moment each real journal actually posts, not
  // before. accrualJournalId is set at APPROVAL, settlementJournalId at
  // PAID. Both null means neither has posted yet (e.g. no GL mapping
  // configured), which is itself a real, visible, checkable state.
  accrualJournalId    String? @map("accrual_journal_id")
  settlementJournalId String? @map("settlement_journal_id")

  createdAt DateTime @default(now()) @map("created_at")

  entries PayrollEntry[]

  @@map("payroll_run")
  @@schema("nexus")
}

model PayrollEntry {
  id           String     @id(map: "pk_payroll_entry") @default(uuid())
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade, map: "fk_payroll_entry_payroll_run")
  payrollRunId String     @map("payroll_run_id")

  employeeId          String
  basicSalary         Decimal @map("basic_salary") @db.Decimal(12, 2)
  grossPay            Decimal @map("gross_pay") @db.Decimal(12, 2)
  taxableIncome        Decimal @map("taxable_income") @db.Decimal(12, 2)
  paye                Decimal @db.Decimal(12, 2)
  ssnitEmployee       Decimal @map("ssnit_employee") @db.Decimal(12, 2)
  ssnitEmployerTier1  Decimal @map("ssnit_employer_tier1") @db.Decimal(12, 2)
  tier2Employer       Decimal @map("tier2_employer") @db.Decimal(12, 2)
  otherDeductions     Decimal @default(0) @map("other_deductions") @db.Decimal(12, 2)
  netPay              Decimal @map("net_pay") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("payroll_entry")
  @@schema("nexus")
}

// doc §209 Allowance and Deduction Management. EmployeeDeduction mirrors
// EmployeeAllowance exactly — same approval path (via the salary
// structure it belongs to), same flat-or-percentage flexibility. Covers
// Insurance, Union, and Custom deductions fully and really, and Loan
// Deductions as a genuine, manually-entered recurring amount (e.g. a
// staff loan repayment instalment) — NOT automatically tied to a
// tracked staff-loan balance/disbursement/schedule, since no such system
// exists anywhere in this schema. Building an automatic link to customer
// Loans specifically would mean fabricating an Employee-to-Customer
// relationship this platform doesn't have; a full staff-lending module
// (its own disbursement, balance, and repayment-schedule tracking) is
// real, separate, additional scope, named here rather than assumed.
model EmployeeDeduction {
  id                        String                  @id(map: "pk_employee_deduction") @default(uuid())
  salaryStructure           EmployeeSalaryStructure @relation(fields: [employeeSalaryStructureId], references: [id], onDelete: Cascade, map: "fk_employee_deduction_salary_structure")
  employeeSalaryStructureId String                  @map("employee_salary_structure_id")
  deductionCodeId           String                  @map("deduction_code_id")

  amount              Decimal @db.Decimal(12, 2) // a flat amount, or a percentage if isPercentageOfBasic
  isPercentageOfBasic Boolean @default(false) @map("is_percentage_of_basic")
  active              Boolean @default(true) // a deduction can be paused (e.g. a loan fully repaid) without losing its history

  @@map("employee_deduction")
  @@schema("nexus")
}

// doc §214 Payroll Accounting. §214.3 "Payroll journals remain balanced"
// / "Ledger postings occur automatically after approval" / "Every
// accounting entry is audited". Genuine accrual accounting: an accrual
// journal is posted the moment a run is APPROVED (expense + liabilities
// recognized), and a separate settlement journal is posted when the run
// is marked PAID (the salaries-payable liability settled against cash) —
// not one combined journal, since that would conflate two genuinely
// different accounting events. Each GL "purpose" here is matched by
// name, the same pattern already proven for Statutory Contribution
// Rates, rather than a rigid one-to-one schema mapping.
model PayrollGLAccountMapping {
  id            String      @id(map: "pk_payroll_gl_account_mapping") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_payroll_gl_account_mapping_institution")
  institutionId String      @map("institution_id")

  purpose     String // e.g. "Salary Expense", "PAYE Payable", "SSNIT Payable", "Tier 2 Payable", "Employer SSNIT Expense", "Employer Tier 2 Expense", "Other Deductions Payable", "Salaries Payable"
  glAccountId String @map("gl_account_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([institutionId, purpose], map: "uq_payroll_gl_mapping_institution_purpose")
  @@map("payroll_gl_account_mapping")
  @@schema("nexus")
}

// GAP-FIN-003 (Implementation Requirements Traceability & Remediation
// Register, 9 Aug 2026): "A loan shall not be represented as financially
// disbursed until the authoritative monetary movement and required
// accounting effects are committed." Same purpose-mapping pattern as
// Payroll/Asset above, but unlike those two, disbursement genuinely
// blocks — proceeding to move real customer cash out of the vault
// without the accounting effect committing is not an acceptable
// disclosed gap the way an unconfigured payroll accrual mapping is.
model LoanGLAccountMapping {
  id            String      @id(map: "pk_loan_gl_account_mapping") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_loan_gl_account_mapping_institution")
  institutionId String      @map("institution_id")

  purpose     String // "Loan Receivable" | "Cash/Bank (Disbursement)"
  glAccountId String @map("gl_account_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([institutionId, purpose], map: "uq_loan_gl_mapping_institution_purpose")
  @@map("loan_gl_account_mapping")
  @@schema("nexus")
}

// GAP-SCH-001 (Implementation Requirements Traceability & Remediation
// Register, 9 Aug 2026): "Every API process starts node-cron jobs; no
// distributed claim/lock or durable worker ownership found" — if this
// app ever scales to more than one Railway instance, every instance
// independently fires the same scheduled jobs at the same moment (double
// interest accrual, double arrears reclassification, etc.). Fixed with a
// database-backed claim rather than standing up a whole separate worker
// service: the unique index below IS the distributed lock. Two processes
// racing to claim the same (jobType, runDate) can't both succeed — one
// INSERT wins, the other hits the unique constraint and skips. No new
// infrastructure, just Postgres doing what it already does.
enum ScheduledJobStatus {
  CLAIMED
  COMPLETED
  FAILED

  @@schema("nexus")
}

model ScheduledJobRun {
  id String @id(map: "pk_scheduled_job_run") @default(uuid())

  jobType             String // e.g. "ARREARS_CHECK", "SAVINGS_INTEREST_ACCRUAL"
  runDate             DateTime // normalized to midnight — the calendar day this run corresponds to, not a timestamp
  executionId         String   @default(uuid()) @map("execution_id")
  claimedByProcessId  String   @map("claimed_by_process_id") // hostname+pid+uuid, identifies which instance won the claim
  claimedAt           DateTime @default(now()) @map("claimed_at")

  status      ScheduledJobStatus @default(CLAIMED)
  completedAt DateTime?          @map("completed_at")
  error       String?

  // The lock itself — not institution-scoped, since each job function
  // already processes every institution in one batch per run.
  @@unique([jobType, runDate], map: "uq_scheduled_job_run_type_date")
  @@map("scheduled_job_run")
  @@schema("nexus")
}

// doc §186-195 Asset Management. §187.3 "Asset codes are unique" /
// "Disposed assets cannot be reassigned" / "Historical asset records
// remain available" / "Every asset modification is audited" — all
// genuinely enforced below, not just stated. Depreciation method is
// configurable per category (a sensible default) and per asset
// (an override), since real institutions genuinely use different
// methods for different asset classes — never assumed as one global
// choice.

enum DepreciationMethod {
  STRAIGHT_LINE
  REDUCING_BALANCE

  @@schema("nexus")
}

model AssetCategory {
  id            String      @id(map: "pk_asset_category") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_asset_category_institution")
  institutionId String      @map("institution_id")

  name                     String
  defaultUsefulLifeMonths  Int                @map("default_useful_life_months")
  defaultDepreciationMethod DepreciationMethod @default(STRAIGHT_LINE) @map("default_depreciation_method")
  defaultDepreciationRate  Decimal?           @map("default_depreciation_rate") @db.Decimal(5, 2) // annual %, for REDUCING_BALANCE

  createdAt DateTime @default(now()) @map("created_at")

  assets Asset[]

  @@unique([institutionId, name], map: "uq_asset_category_institution_name")
  @@map("asset_category")
  @@schema("nexus")
}

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  DISPOSED
  LOST

  @@schema("nexus")
}

model Asset {
  id            String      @id(map: "pk_asset") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_asset_institution")
  institutionId String      @map("institution_id")
  category      AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, map: "fk_asset_category")
  categoryId    String      @map("category_id")

  assetCode    String @map("asset_code")
  name         String
  serialNumber String? @map("serial_number")
  manufacturer String?
  model        String?

  acquisitionDate DateTime @map("acquisition_date")
  acquisitionCost Decimal  @map("acquisition_cost") @db.Decimal(14, 2)
  supplierName    String?  @map("supplier_name")
  warrantyExpiryDate DateTime? @map("warranty_expiry_date")
  installationDate   DateTime? @map("installation_date")
  commissionedDate   DateTime? @map("commissioned_date")

  usefulLifeMonths   Int                @map("useful_life_months")
  residualValue      Decimal            @default(0) @map("residual_value") @db.Decimal(14, 2)
  depreciationMethod DepreciationMethod @map("depreciation_method")
  depreciationRate   Decimal?           @map("depreciation_rate") @db.Decimal(5, 2) // annual %, for REDUCING_BALANCE, overrides category default

  accumulatedDepreciation Decimal @default(0) @map("accumulated_depreciation") @db.Decimal(14, 2)

  status AssetStatus @default(ACTIVE)

  // §189 current allocation, denormalized for fast lookup — the full
  // history lives in AssetAllocation, this just reflects "right now".
  currentEmployeeId   String? @map("current_employee_id")
  currentDepartmentId String? @map("current_department_id")
  currentBranchId     String? @map("current_branch_id")

  barcodeValue String? @map("barcode_value")
  qrCodeValue  String? @map("qr_code_value")
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)

  disposedAt     DateTime? @map("disposed_at")
  disposalReason String?   @map("disposal_reason")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  allocations         AssetAllocation[]
  transfersFrom       AssetTransfer[] @relation("AssetTransferAsset")
  maintenanceSchedule AssetMaintenanceSchedule?
  maintenanceRecords  AssetMaintenanceRecord[]
  depreciationEntries AssetDepreciationEntry[]
  disposal            AssetDisposal?
  verificationRecords AssetVerificationRecord[]

  @@unique([institutionId, assetCode], map: "uq_asset_institution_code")
  @@map("asset")
  @@schema("nexus")
}

// doc §189 Asset Allocation Management. A real history table — every
// assignment and return is its own row, permanently retained, never
// overwritten.
model AssetAllocation {
  id            String      @id(map: "pk_asset_allocation") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_asset_allocation_institution")
  institutionId String      @map("institution_id")
  asset         Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade, map: "fk_asset_allocation_asset")
  assetId       String      @map("asset_id")

  employeeId   String?
  departmentId String?
  branchId     String?

  allocatedAt     DateTime  @default(now()) @map("allocated_at")
  allocatedById   String    @map("allocated_by_id")
  returnedAt      DateTime? @map("returned_at")
  returnCondition String?   @map("return_condition")
  notes           String?

  @@map("asset_allocation")
  @@schema("nexus")
}

enum AssetTransferStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED

  @@schema("nexus")
}

// doc §190 Asset Transfer Management. §190.3 "Transfers require
// authorisation" — routed through the real Approval Workflow, the same
// pattern as every other approval-gated action in this platform.
model AssetTransfer {
  id            String               @id(map: "pk_asset_transfer") @default(uuid())
  institution   Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_asset_transfer_institution")
  institutionId String               @map("institution_id")
  asset         Asset                @relation("AssetTransferAsset", fields: [assetId], references: [id], onDelete: Cascade, map: "fk_asset_transfer_asset")
  assetId       String               @map("asset_id")

  fromEmployeeId   String?
  fromDepartmentId String?
  fromBranchId     String?
  toEmployeeId     String?
  toDepartmentId   String?
  toBranchId       String?

  reason        String
  status        AssetTransferStatus @default(PENDING_APPROVAL)
  requestedById String              @map("requested_by_id")
  transferredAt DateTime?           @map("transferred_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@map("asset_transfer")
  @@schema("nexus")
}

// doc §191 Asset Maintenance Management. §191.3 "Overdue maintenance
// generates alerts" — no notification provider exists in this
// platform, so this is a real, queryable overdue-items report, not a
// push notification.
model AssetMaintenanceSchedule {
  id            String   @id(map: "pk_asset_maintenance_schedule") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_asset_maintenance_schedule_institution")
  institutionId String   @map("institution_id")
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade, map: "fk_asset_maintenance_schedule_asset")
  assetId       String   @unique @map("asset_id")

  frequencyMonths   Int       @map("frequency_months")
  lastMaintenanceDate DateTime? @map("last_maintenance_date")
  nextDueDate       DateTime  @map("next_due_date")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("asset_maintenance_schedule")
  @@schema("nexus")
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE

  @@schema("nexus")
}

model AssetMaintenanceRecord {
  id            String   @id(map: "pk_asset_maintenance_record") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_asset_maintenance_record_institution")
  institutionId String   @map("institution_id")
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade, map: "fk_asset_maintenance_record_asset")
  assetId       String   @map("asset_id")

  type            MaintenanceType
  scheduledDate   DateTime? @map("scheduled_date")
  completedDate   DateTime? @map("completed_date")
  serviceProvider String?   @map("service_provider")
  cost            Decimal   @default(0) @db.Decimal(12, 2)
  notes           String?

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("asset_maintenance_record")
  @@schema("nexus")
}

// doc §192 Asset Depreciation Management. §192.3 "Depreciation postings
// generate balanced journal entries" / "Historical depreciation records
// remain available" — one immutable row per posted period, never
// overwritten, each optionally carrying a real GL journal reference.
model AssetDepreciationEntry {
  id            String   @id(map: "pk_asset_depreciation_entry") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_asset_depreciation_entry_institution")
  institutionId String   @map("institution_id")
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade, map: "fk_asset_depreciation_entry_asset")
  assetId       String   @map("asset_id")

  periodLabel             String  @map("period_label") // e.g. "January 2026"
  depreciationAmount      Decimal @map("depreciation_amount") @db.Decimal(14, 2)
  accumulatedDepreciation Decimal @map("accumulated_depreciation") @db.Decimal(14, 2) // running total AFTER this entry
  netBookValue            Decimal @map("net_book_value") @db.Decimal(14, 2) // AFTER this entry

  journalId   String?  @map("journal_id")
  postedById  String   @map("posted_by_id")
  postedAt    DateTime @default(now()) @map("posted_at")

  @@unique([assetId, periodLabel], map: "uq_asset_depreciation_asset_period")
  @@map("asset_depreciation_entry")
  @@schema("nexus")
}

enum AssetDisposalType {
  SALE
  DONATION
  WRITE_OFF
  SCRAP

  @@schema("nexus")
}

enum AssetDisposalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED

  @@schema("nexus")
}

// doc §193 Asset Disposal Management. §193.3 "Financial gains or losses
// are calculated automatically" — genuinely computed (saleProceeds
// minus net book value at disposal), not left for someone to work out
// by hand.
model AssetDisposal {
  id            String   @id(map: "pk_asset_disposal") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_asset_disposal_institution")
  institutionId String   @map("institution_id")
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade, map: "fk_asset_disposal_asset")
  assetId       String   @unique @map("asset_id")

  disposalType         AssetDisposalType
  disposalDate          DateTime
  saleProceeds          Decimal? @map("sale_proceeds") @db.Decimal(14, 2)
  netBookValueAtDisposal Decimal @map("net_book_value_at_disposal") @db.Decimal(14, 2)
  gainLoss              Decimal @map("gain_loss") @db.Decimal(14, 2) // saleProceeds - netBookValueAtDisposal (0 proceeds for write-off/scrap/donation)
  reason                String

  status        AssetDisposalStatus @default(PENDING_APPROVAL)
  requestedById String              @map("requested_by_id")
  approvedById  String?             @map("approved_by_id")
  journalId     String?             @map("journal_id")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@map("asset_disposal")
  @@schema("nexus")
}

enum AssetCondition {
  GOOD
  FAIR
  POOR
  DAMAGED
  MISSING

  @@schema("nexus")
}

// doc §194 Asset Verification and Audit. §194.3 "Missing assets are
// flagged automatically" — variance is a real computed boolean, not a
// manual judgment call left to whoever reviews the record later.
model AssetVerificationRecord {
  id            String   @id(map: "pk_asset_verification_record") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_asset_verification_record_institution")
  institutionId String   @map("institution_id")
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade, map: "fk_asset_verification_record_asset")
  assetId       String   @map("asset_id")

  verifiedById       String   @map("verified_by_id")
  verifiedAt         DateTime @default(now()) @map("verified_at")
  locationConfirmed  Boolean  @map("location_confirmed")
  custodianConfirmed Boolean  @map("custodian_confirmed")
  condition          AssetCondition
  latitude           Decimal? @db.Decimal(10, 7)
  longitude          Decimal? @db.Decimal(10, 7)
  notes              String?
  variance           Boolean  @default(false) // true if location/custodian/condition didn't match expectations

  @@map("asset_verification_record")
  @@schema("nexus")
}

// doc §188.2 "Accounting Entries" / §192.2 / §193.2 — real GL account
// mapping, the exact same name-matched, configurable pattern already
// proven for Payroll, reused here rather than a fresh, parallel design.
model AssetGLAccountMapping {
  id            String      @id(map: "pk_asset_gl_account_mapping") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_asset_gl_account_mapping_institution")
  institutionId String      @map("institution_id")

  purpose     String // e.g. "Fixed Asset", "Depreciation Expense", "Accumulated Depreciation", "Cash/Bank (Acquisition)", "Cash/Bank (Disposal Proceeds)", "Gain on Disposal", "Loss on Disposal"
  glAccountId String @map("gl_account_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([institutionId, purpose], map: "uq_asset_gl_mapping_institution_purpose")
  @@map("asset_gl_account_mapping")
  @@schema("nexus")
}

// doc §43 Customer Consent Management. §43.5 "Consent records cannot be
// deleted" — genuinely enforced: no delete route exists anywhere for
// this model. §43.5 "Consent withdrawals take immediate effect where
// applicable" — withdrawal is recorded on the SAME row (withdrawnAt),
// not a separate row, so there's exactly one current state per consent
// to check, not a history to reconstruct at read time.
enum ConsentType {
  DATA_PROCESSING
  MARKETING
  SMS
  EMAIL
  PUSH_NOTIFICATION
  BIOMETRIC
  CREDIT_BUREAU
  INFORMATION_SHARING
  DIGITAL_SIGNATURE
  OTHER

  @@schema("nexus")
}

model CustomerConsent {
  id            String      @id(map: "pk_customer_consent") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_customer_consent_institution")
  institutionId String      @map("institution_id")
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "fk_customer_consent_customer")
  customerId    String      @map("customer_id")

  consentType      ConsentType @map("consent_type")
  otherTypeLabel   String?     @map("other_type_label") // for OTHER / institution-defined consents
  granted          Boolean
  grantedAt        DateTime    @default(now()) @map("granted_at")
  expiresAt        DateTime?   @map("expires_at")
  withdrawnAt      DateTime?   @map("withdrawn_at")
  withdrawnById    String?     @map("withdrawn_by_id")
  documentId       String?     @map("document_id") // links to the existing Document model, if a signed consent form was attached
  capturedById     String      @map("captured_by_id")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("customer_consent")
  @@schema("nexus")
}

enum CustomerMergeStatus {
  ACTIVE
  MERGED

  @@schema("nexus")
}

enum CustomerMergeRecordStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ROLLED_BACK

  @@schema("nexus")
}

// doc §35 Customer Merge and Duplicate Management. §35.4 "Merge
// operations require authorised approval" via the real Approval
// Workflow. §35.4 "Merged records preserve transaction history" —
// reassignedRecords is the real, exact list of what moved, by model and
// ID, making a genuine rollback possible rather than an approximation.
model CustomerMergeRecord {
  id            String      @id(map: "pk_customer_merge_record") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_customer_merge_record_institution")
  institutionId String      @map("institution_id")

  primaryCustomer   Customer @relation("PrimaryCustomer", fields: [primaryCustomerId], references: [id], onDelete: Cascade, map: "fk_customer_merge_primary")
  primaryCustomerId String   @map("primary_customer_id")
  mergedCustomer    Customer @relation("MergedCustomer", fields: [mergedCustomerId], references: [id], onDelete: Cascade, map: "fk_customer_merge_merged")
  mergedCustomerId  String   @map("merged_customer_id")

  similarityScore Int      @map("similarity_score")
  matchedFields   Json     @map("matched_fields") // string[]
  status          CustomerMergeRecordStatus @default(PENDING_APPROVAL)

  // Exactly which records moved, captured at merge execution time — the
  // real basis for rollback: [{ model: "Loan", id: "..." }, ...]
  reassignedRecords Json? @map("reassigned_records")

  requestedById  String    @map("requested_by_id")
  approvedById   String?   @map("approved_by_id")
  mergedAt       DateTime? @map("merged_at")
  rolledBackById String?   @map("rolled_back_by_id")
  rolledBackAt   DateTime? @map("rolled_back_at")
  rollbackReason String?   @map("rollback_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("customer_merge_record")
  @@schema("nexus")
}

// doc §25.3 "Saved Searches"
model SavedSearch {
  id            String      @id(map: "pk_saved_search") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_saved_search_institution")
  institutionId String      @map("institution_id")

  userId    String
  name      String
  criteria  Json // the saved search parameters
  createdAt DateTime @default(now()) @map("created_at")

  @@map("saved_search")
  @@schema("nexus")
}
