// doc §30 Customer Document Management, Technical Spec §69 Document Entity
// Architecture. storageReference points into Supabase Storage — the file
// bytes never live in Postgres, only this metadata + integrity checksum.
enum DocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENCE
  VOTER_ID
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  UTILITY_BILL
  PROOF_OF_ADDRESS
  PHOTOGRAPH
  SIGNATURE
  LOAN_DOCUMENT
  CONTRACT
  CONSENT_FORM
  OTHER

  @@schema("nexus")
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  APPROVED
  ACTIVE
  ARCHIVED
  DISPOSED

  @@schema("nexus")
}

model Document {
  id            String      @id(map: "pk_document") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_document_institution")
  institutionId String      @map("institution_id")
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "fk_document_customer")
  customerId    String?     @map("customer_id")

  documentName     String         @map("document_name")
  documentType     DocumentType   @map("document_type")
  category         String?
  storageReference String         @map("storage_reference")
  checksum         String
  fileSize         Int            @map("file_size")
  mimeType         String         @map("mime_type")
  versionNumber    Int            @default(1) @map("version_number")
  expiryDate       DateTime?      @map("expiry_date")
  status           DocumentStatus @default(UPLOADED)
  uploadedById     String?        @map("uploaded_by_id")

  // doc §30.3 "Replace documents... support version history" — Replace
  // creates a new Document row linked back to the one it supersedes, and
  // auto-archives the old one, rather than each upload being independent.
  replacesDocument   Document? @relation("DocumentVersionChain", fields: [replacesDocumentId], references: [id], map: "fk_document_replaces_document")
  replacesDocumentId String?   @unique @map("replaces_document_id")
  replacedBy         Document? @relation("DocumentVersionChain")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@map("document")
  @@schema("nexus")
}

