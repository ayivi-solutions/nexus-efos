// conditions/actions (JSON, evaluated by lib/businessRules.ts), priority,
// effectiveDate/expiryDate, status (a pragmatic 4-state compression of
// §41.6's fuller Identification→...→Retirement lifecycle, the same
// compression pattern already used for Product Lifecycle), businessOwnerId.
// "Version"/"Audit History" from §41.7 are satisfied by the existing
// PDDS versionNo (auto-incremented on every update) and AuditLog, not a
// redundant parallel field.
//
// Wired into exactly ONE real trigger point (Loan Initiation) rather than
// stubbed across many — genuinely evaluated against every loan created,
// not a configuration screen for rules that never actually run.
enum BusinessRuleCategory {
  VALIDATION
  ELIGIBILITY
  CALCULATION
  APPROVAL
  COMPLIANCE
  NOTIFICATION

  @@schema("nexus")
}

enum BusinessRuleStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  RETIRED

  @@schema("nexus")
}

enum BusinessRuleTriggerPoint {
  LOAN_INITIATION
  LOAN_APPROVAL
  LOAN_DISBURSEMENT
  SAVINGS_ACCOUNT_OPENING
  CUSTOMER_CREATION
  EMPLOYEE_ONBOARDING

  @@schema("nexus")
}

model BusinessRule {
  id             String                   @id(map: "pk_business_rule") @default(uuid())
  institution    Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_business_rule_institution")
  institutionId  String                   @map("institution_id")

  ruleCode       String                   @map("rule_code") // e.g. "BR-001", human-referenceable
  name           String
  businessPurpose String?                 @map("business_purpose")
  description    String?
  category       BusinessRuleCategory
  triggerPoint   BusinessRuleTriggerPoint @map("trigger_point")

  // Conditions: [{ field, operator, value }], evaluated per §41.9's
  // "configuration driven" principle — an administrator edits data, not code.
  conditions     Json
  conditionLogic String  @default("ALL") @map("condition_logic") // ALL (AND) | ANY (OR)

  // Actions: [{ type, params }] — FLAG | REQUIRE_ADDITIONAL_APPROVAL | REJECT
  actions        Json

  priority       Int      @default(100) // lower evaluates first
  effectiveDate  DateTime? @map("effective_date")
  expiryDate     DateTime? @map("expiry_date")
  status         BusinessRuleStatus @default(DRAFT)
  businessOwnerId String? @map("business_owner_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@map("business_rule")
  @@schema("nexus")
}

// doc §50 Master Data Management Framework — normalized lookup tables for
// Employee's Department/Position, replacing what were previously
// free-text strings that could drift (typos, inconsistent capitalization,
// no single source of truth for "which departments exist").
model Department {
  id            String       @id(map: "pk_department") @default(uuid())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_department_institution")
  institutionId String       @map("institution_id")
  name          String
  code          String?

  employees Employee[]
  positions Position[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")

  @@unique([institutionId, name], map: "uq_department_institution_id_name")
  @@map("department")
  @@schema("nexus")
}

model Position {
  id            String       @id(map: "pk_position") @default(uuid())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_position_institution")
  institutionId String       @map("institution_id")
  title         String
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull, map: "fk_position_department")
  departmentId  String?      @map("department_id")

  employees Employee[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")

  @@unique([institutionId, title], map: "uq_position_institution_id_title")
  @@map("position")
  @@schema("nexus")
}

// doc §77 Loan Arrears Management + §71 Loan Penalty Management.
enum ArrearsClassification {
  CURRENT
  ARREARS_1_30
  ARREARS_31_60
  ARREARS_61_90
  ARREARS_90_PLUS

  @@schema("nexus")
}

enum PromiseToPayStatus {
  PENDING
  KEPT
  BROKEN

  @@schema("nexus")
}

// §77.2 "Promise-to-Pay Recording" — a genuine, dated commitment a customer
// makes during a collection follow-up call, tracked to see if it's honoured.
model PromiseToPay {
  id            String             @id(map: "pk_promise_to_pay") @default(uuid())
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_promise_to_pay_institution")
  institutionId String             @map("institution_id")
  loan          Loan               @relation(fields: [loanId], references: [id], onDelete: Cascade, map: "fk_promise_to_pay_loan")
  loanId        String             @map("loan_id")

  promisedAmount Decimal            @map("promised_amount") @db.Decimal(14, 2)
  promisedDate   DateTime           @map("promised_date")
  status         PromiseToPayStatus @default(PENDING)
  notes          String?
  recordedById   String?            @map("recorded_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("promise_to_pay")
  @@schema("nexus")
}

enum LoanPenaltyCalculationMethod {
  FIXED
  PERCENTAGE

  @@schema("nexus")
}

enum LoanPenaltyStatus {
  APPLIED
  WAIVED
  REVERSED

  @@schema("nexus")
}

// doc §71 Loan Penalty Management. Deliberately its own ledger of penalty
// events rather than folded into LoanInstallment — §71.3 requires waivers
// and reversals to be independently authorised and audited, which needs
// its own real record, not a mutable field on the installment it applies to.
model LoanPenalty {
  id            String                       @id(map: "pk_loan_penalty") @default(uuid())
  institution   Institution                  @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_loan_penalty_institution")
  institutionId String                       @map("institution_id")
  loan          Loan                         @relation(fields: [loanId], references: [id], onDelete: Cascade, map: "fk_loan_penalty_loan")
  loanId        String                       @map("loan_id")
  installmentId String?                      @map("installment_id") // which overdue installment triggered this, if applicable

  calculationMethod LoanPenaltyCalculationMethod @map("calculation_method")
  rateOrAmount      Decimal                      @map("rate_or_amount") @db.Decimal(14, 2) // a percentage (e.g. 2 = 2%) or a fixed GHS amount, per calculationMethod
  amount            Decimal                      @db.Decimal(14, 2) // the actual computed penalty amount
  status            LoanPenaltyStatus            @default(APPLIED)

  appliedAt    DateTime  @default(now()) @map("applied_at")
  waivedById   String?   @map("waived_by_id")
  waivedAt     DateTime? @map("waived_at")
  waivedReason String?   @map("waived_reason")

  @@map("loan_penalty")
  @@schema("nexus")
}

// doc §64 Credit Assessment. §64.3's "Credit Bureau Enquiries" is
// deliberately NOT integrated — that needs a real contract and API
// credentials with an actual Ghana credit bureau, the same category of
// external dependency as the SMS/Email provider gap. creditBureauChecked
// is a manual attestation field, honest about being outside the system
// rather than a fake integration pretending to check something it can't.
enum CreditRecommendation {
  APPROVE
  REVIEW
  DECLINE

  @@schema("nexus")
}

model CreditAssessment {
  id            String       @id(map: "pk_credit_assessment") @default(uuid())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_credit_assessment_institution")
  institutionId String       @map("institution_id")
  loan          Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade, map: "fk_credit_assessment_loan")
  loanId        String       @unique @map("loan_id")

  // §64.3 Income/Expense/Debt-to-Income Analysis
  monthlyIncome           Decimal @map("monthly_income") @db.Decimal(14, 2)
  monthlyExpenses         Decimal @map("monthly_expenses") @db.Decimal(14, 2)
  existingLoanObligations Decimal @default(0) @map("existing_loan_obligations") @db.Decimal(14, 2) // auto-computed from this customer's other active loans at assessment time
  proposedInstallment     Decimal @map("proposed_installment") @db.Decimal(14, 2) // this loan's own monthly installment, from its generated schedule

  debtToIncomeRatio       Decimal @map("debt_to_income_ratio") @db.Decimal(5, 2) // existingLoanObligations / monthlyIncome, as a percentage
  repaymentCapacityRatio  Decimal @map("repayment_capacity_ratio") @db.Decimal(5, 2) // (existingLoanObligations + proposedInstallment) / monthlyIncome, as a percentage — the real affordability test

  // §64.3 Risk Scoring — stored with its components, not just a final
  // number, so §64.4 "Recommendations remain auditable" means something
  // real: the reasoning is visible, not a black box.
  riskScore      Int      @map("risk_score") // 0-100
  scoreBreakdown Json     @map("score_breakdown") // { factor: string, points: number }[]
  recommendation CreditRecommendation

  // §64.3 Credit Bureau Enquiries — see note above.
  creditBureauChecked Boolean  @default(false) @map("credit_bureau_checked")
  creditBureauNotes   String?  @map("credit_bureau_notes")

  // §64.4 "Manual overrides require authorisation"
  overridden       Boolean   @default(false)
  overriddenById   String?   @map("overridden_by_id")
  overriddenAt     DateTime? @map("overridden_at")
  overrideReason   String?   @map("override_reason")

  assessedById String   @map("assessed_by_id")
  assessedAt   DateTime @default(now()) @map("assessed_at")

  @@map("credit_assessment")
  @@schema("nexus")
}

// doc §65 Guarantor Management.
enum GuarantorStatus {
  PENDING
  APPROVED
  RELEASED

  @@schema("nexus")
}

model Guarantor {
  id            String          @id(map: "pk_guarantor") @default(uuid())
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_guarantor_institution")
  institutionId String          @map("institution_id")
