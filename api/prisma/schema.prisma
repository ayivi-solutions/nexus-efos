// ---------------------------------------------------------------------------
// APPROVAL WORKFLOW — a single shared capability underneath four separate
// doc requirements that each said "requires approval where configured":
// §24 critical customer profile updates, §36 account holder ownership
// changes, §47/§62 product activation, and AML adjudication (§34). Rather
// than building four bespoke approval mechanisms, every one of them creates
// an ApprovalRequest; approving/rejecting it is a single generic action
// that then applies (or discards) whatever `payload` describes against
// `targetType`/`targetId`. Segregation of duties applies uniformly:
// requestedById and resolvedById can never be the same user.
// ---------------------------------------------------------------------------

enum ApprovalRequestType {
  CUSTOMER_STATUS_CHANGE
  CUSTOMER_PROFILE_UPDATE
  ACCOUNT_HOLDER_ADD
  PRODUCT_ACTIVATION
  AML_ADJUDICATION
  BUSINESS_RULE_ACTIVATION // §41.6 — a rule itself needs authorised approval before going live
  BUSINESS_RULE_TRIGGERED  // a rule's REQUIRE_ADDITIONAL_APPROVAL action fired against a real loan
  LOAN_RESTRUCTURE // doc §72
  LOAN_RESCHEDULE  // doc §73
  LOAN_WRITE_OFF   // doc §74
  COLLECTION_VARIANCE_ADJUSTMENT // doc §82
  COMMISSION_PAYMENT // doc §83
  SAVINGS_RESTRICTION_CREATE  // doc §54
  SAVINGS_RESTRICTION_REMOVE  // doc §54
  CASH_TRANSFER  // doc §114
  CASH_BALANCING_VARIANCE  // doc §115
  JOURNAL_POSTING  // doc §118
  FINANCIAL_PERIOD_REOPEN  // doc §120
  RECURRING_JOURNAL_ACTIVATION  // doc §122
  INTER_BRANCH_TRANSFER  // doc §121
  SALARY_STRUCTURE_CHANGE  // doc §208
  PAYROLL_RUN_APPROVAL  // doc §211
  ATTENDANCE_CORRECTION  // doc §201.3 "Corrections require approval"
  AUDIT_ENGAGEMENT_APPROVAL  // ETAS §78.7 "Every audit shall have an approved scope"
  ASSET_TRANSFER  // doc §190
  ASSET_DISPOSAL  // doc §193
  CUSTOMER_MERGE  // doc §35

  @@schema("nexus")
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("nexus")
}

model ApprovalRequest {
  id            String                @id(map: "pk_approval_request") @default(uuid())
  institution   Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_approval_request_institution")
  institutionId String                @map("institution_id")
  type          ApprovalRequestType
  status        ApprovalRequestStatus @default(PENDING)

  targetType String  @map("target_type")
  targetId   String  @map("target_id")
  payload    Json
  reason     String?

  requestedById  String    @map("requested_by_id")
  requestedAt    DateTime  @default(now()) @map("requested_at")
  resolvedById   String?   @map("resolved_by_id")
  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@map("approval_request")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// PRODUCTS (Technical Spec §84 — Product Entity Architecture). A Product is
// versioned: every Loan/SavingsAccount locks in the exact ProductVersion it
// was opened under, so revising a product later never silently changes the
// terms of existing accounts. Pragmatic compression: the spec's 7-state
// product lifecycle (Designed/Approved/Published/Active/Suspended/
// Withdrawn/Archived) is collapsed to 4 for a first pass.
// ---------------------------------------------------------------------------

enum ProductType {
  SAVINGS
  LOAN

  @@schema("nexus")
}

// doc's Product Lifecycle model has 9 ideation-through-retirement stages;
// most (Opportunity/Concept/Design) describe pre-system work that happens
// before a Product row would ever exist here. PENDING_APPROVAL added as a
// genuine, honest 5th state — it now reflects on the Product record itself
// that an activation request is in flight, rather than silently staying
// DRAFT the whole time the Approval Workflow is resolving it.
enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  WITHDRAWN
  ARCHIVED

  @@schema("nexus")
}

model Product {
  id            String        @id(map: "pk_product") @default(uuid())
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_product_institution")
  institutionId String        @map("institution_id")
  code          String
  type          ProductType
  status        ProductStatus @default(DRAFT)

  versions         ProductVersion[] @relation("AllVersions")
  currentVersion   ProductVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], map: "fk_product_current_version")
  currentVersionId String?          @unique @map("current_version_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([institutionId, code], map: "uq_product_institution_id_code")
  @@map("product")
  @@schema("nexus")
}

model ProductVersion {
  id            String  @id(map: "pk_product_version") @default(uuid())
  product       Product @relation("AllVersions", fields: [productId], references: [id], onDelete: Cascade, map: "fk_product_version_product")
  productId     String  @map("product_id")
  versionNumber Int     @map("version_number")

  name        String
  description String?
  currency    String  @default("GHS")
  category    String?   @map("product_category") // PDDS §39 — broader classification above LOAN/SAVINGS type
  effectiveTo DateTime? @map("effective_to")       // PDDS §39 — explicit version end-date; null while current

  // Savings-specific (null for LOAN products)
  minOpeningBalance   Decimal? @map("min_opening_balance") @db.Decimal(14, 2)
  minOperatingBalance Decimal? @map("min_operating_balance") @db.Decimal(14, 2)
  maxBalance          Decimal? @map("max_balance") @db.Decimal(14, 2)
  minDeposit          Decimal? @map("min_deposit") @db.Decimal(14, 2)
  maxDeposit          Decimal? @map("max_deposit") @db.Decimal(14, 2)

  // Loan-specific (null for SAVINGS products)
  minLoanAmount   Decimal? @map("min_loan_amount") @db.Decimal(14, 2)
  maxLoanAmount   Decimal? @map("max_loan_amount") @db.Decimal(14, 2)
  minTenureMonths Int?     @map("min_tenure_months")
  maxTenureMonths Int?     @map("max_tenure_months")

  interestMethod String  @default("FLAT") @map("interest_method")
  interestRate   Decimal @map("interest_rate") @db.Decimal(5, 2)
  feeStructure   Json?   @map("fee_structure")

  // doc §52.3/§52.4 Savings Interest Management — interestMethod for
  // SAVINGS products additionally takes DAILY_BALANCE, AVERAGE_DAILY_BALANCE,
  // or MINIMUM_MONTHLY_BALANCE (Loan products keep FLAT/REDUCING_BALANCE).
  // interestRateType distinguishes FIXED / TIERED / VARIABLE / PROMOTIONAL —
  // all four named as required functional capabilities, not optional.
  interestRateType  String   @default("FIXED") @map("interest_rate_type")
  promoInterestRate Decimal? @map("promo_interest_rate") @db.Decimal(6, 3)
  promoDurationDays Int?     @map("promo_duration_days")

  effectiveDate DateTime @default(now()) @map("effective_date")
  createdAt     DateTime @default(now()) @map("created_at")

  currentForProduct Product?           @relation("CurrentVersion")
  loans             Loan[]
  savingsAccounts   SavingsAccount[]
  interestRateTiers InterestRateTier[]

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([productId, versionNumber], map: "uq_product_version_product_id_version_number")
  @@map("product_version")
  @@schema("nexus")
}

