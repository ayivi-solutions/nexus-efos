// Nexus EFOS — Core Platform schema
// Maps to doc §21 (Layer 1: Core Platform — Enterprise Identity, Security),
// §38 (User Role Architecture), §39 (Permission and Access Control Framework)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["nexus"]
}

// ---------------------------------------------------------------------------
// INSTITUTIONS  (doc §14.3 — Financial Institutions)
// ---------------------------------------------------------------------------

enum InstitutionType {
  INDIVIDUAL_SUSU_OPERATOR
  MICROFINANCE_INSTITUTION
  SAVINGS_AND_LOANS_COMPANY
  CREDIT_UNION
  COOPERATIVE_SOCIETY
  RURAL_COMMUNITY_BANK
  AGENCY_BANKING_NETWORK
  DIGITAL_LENDING_INSTITUTION

  @@schema("nexus")
}

enum InstitutionStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@schema("nexus")
}

model Institution {
  id             String            @id(map: "pk_institution") @default(uuid())
  legalName      String            @map("legal_name")
  tradingName    String?           @map("trading_name")
  type           InstitutionType
  status         InstitutionStatus @default(PENDING_ONBOARDING)
  regulatorId    String?           @map("regulator_id") // e.g. BoG license / registration number
  country        String            @default("GH")
  region         String?
  phone          String?
  email          String?
  onboardingStep Int               @default(1) @map("onboarding_step") // 1..5, drives onboarding wizard
  // Deliberately narrow gate for the demo-link feature (auth.routes.ts
  // POST/GET /auth/demo-link) — a shareable pre-filled-credentials login
  // link can only ever be minted for a user belonging to an institution
  // flagged isDemo. Without this, the same mechanism could leak a real
  // pilot customer-facing user's working credentials into a URL by
  // mistake. Never set true on a real pilot institution.
  isDemo         Boolean           @default(false) @map("is_demo")

  branches                Branch[]
  users                   User[]
  roles                   Role[]
  customers               Customer[]
  loans                   Loan[]
  savingsAccounts         SavingsAccount[]
  auditLogs               AuditLog[]
  employees               Employee[]
  products                Product[]
  watchlistEntries        WatchlistEntry[]
  accountHolders          AccountHolder[]
  documents               Document[]
  approvalRequests        ApprovalRequest[]
  savingsInterestAccruals SavingsInterestAccrual[]
  savingsInterestPostings SavingsInterestPosting[]
  importBatches           ImportBatch[]
  businessRules           BusinessRule[]
  departments             Department[]
  positions               Position[]
  promisesToPay           PromiseToPay[]
  loanPenalties           LoanPenalty[]
  creditAssessments       CreditAssessment[]
  guarantors              Guarantor[]
  collateral              Collateral[]
  collectors              Collector[]
  collectionRoutes        CollectionRoute[]
  collectionTransactions  CollectionTransaction[]
  collectionSettlements   CollectionSettlement[]
  commissionStructures    CommissionStructure[]
  commissionRecords       CommissionRecord[]
  savingsFeeTypes         SavingsFeeType[]
  savingsFeeCharges       SavingsFeeCharge[]
  savingsRestrictions     SavingsRestriction[]
  standingInstructions    StandingInstruction[]
  savingsStatements       SavingsStatement[]
  vaults                  Vault[]
  tellers                 Teller[]
  cashLedgerEntries       CashLedgerEntry[]
  cashTransfers           CashTransfer[]
  cashBalancings          CashBalancing[]
  cheques                 Cheque[]
  customerInteractions    CustomerInteraction[]
  customerComplaints      CustomerComplaint[]
  attendanceRecords       AttendanceRecord[]
  performanceReviews      PerformanceReview[]
  disciplinaryCases       DisciplinaryCase[]
  auditEngagements        AuditEngagement[]
  auditFindings           AuditFinding[]
  regulatoryCapitalSnapshots RegulatoryCapitalSnapshot[]
  notificationProviderConfigs NotificationProviderConfig[]
  loanGLAccountMappings        LoanGLAccountMapping[]
  demoLinkTokens                DemoLinkToken[]
  notifications                Notification[]
  glAccounts              GLAccount[]
  journals                Journal[]
  fiscalYears             FiscalYear[]
  financialPeriods        FinancialPeriod[]
  recurringJournals       RecurringJournal[]
  branchSettlementAccounts BranchSettlementAccount[]
  interBranchTransfers    InterBranchTransfer[]
  payrollCalendars        PayrollCalendar[]
  payrollPeriods          PayrollPeriod[]
  salaryGrades            SalaryGrade[]
  payGroups               PayGroup[]
  earningCodes            EarningCode[]
  deductionCodes          DeductionCode[]
  taxTables               TaxTable[]
  statutoryContributionRates StatutoryContributionRate[]
  employeeSalaryStructures EmployeeSalaryStructure[]
  overtimeRules           OvertimeRule[]
  payrollRuns             PayrollRun[]
  payrollGLMappings       PayrollGLAccountMapping[]
  assetCategories         AssetCategory[]
  assets                  Asset[]
  assetAllocations        AssetAllocation[]
  assetTransfers          AssetTransfer[]
  assetMaintenanceSchedules AssetMaintenanceSchedule[]
  assetMaintenanceRecords AssetMaintenanceRecord[]
  assetDepreciationEntries AssetDepreciationEntry[]
  assetDisposals          AssetDisposal[]
  assetVerificationRecords AssetVerificationRecord[]
  assetGLMappings         AssetGLAccountMapping[]
  customerConsents        CustomerConsent[]
  customerMergeRecords    CustomerMergeRecord[]
  savedSearches           SavedSearch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@map("institution")
  @@schema("nexus")
}

model Branch {
  id            String      @id(map: "pk_branch") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_branch_institution")
  institutionId String      @map("institution_id")
  name          String
  code          String
  region        String?
  isHeadOffice  Boolean     @default(false) @map("is_head_office")

  userRoles       UserRole[]
  customers       Customer[]
  loans           Loan[]
  savingsAccounts SavingsAccount[]
  employees       Employee[]
  collectionRoutes CollectionRoute[]
  auditEngagements AuditEngagement[]

  archived   Boolean   @default(false)
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([institutionId, code], map: "uq_branch_institution_id_code")
  @@map("branch")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// USERS  (doc §38.5 — Internal / External user categories)
// ---------------------------------------------------------------------------

enum UserCategory {
  INTERNAL // employees
  EXTERNAL // customers, agents, partners, regulators, developers

  @@schema("nexus")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@schema("nexus")
}

model User {
  id            String      @id(map: "pk_user") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_user_institution")
  institutionId String      @map("institution_id")

  fullName     String       @map("full_name")
  email        String
  phone        String?
  passwordHash String       @map("password_hash")
  category     UserCategory @default(INTERNAL)
  status       UserStatus   @default(INVITED)
  mfaEnabled   Boolean      @default(false) @map("mfa_enabled")

  // PDDS §034/§136, ESS §26 — User security fields (Phase 4). Policy
  // thresholds enforced against these (lockout count/window, password
  // expiry window, history depth) are disclosed defaults, not values taken
  // from any working document — see docs/security-policy-defaults.md.
  // Nothing here invents an enforced value the platform doesn't disclose.
  failedLoginCount    Int       @default(0) @map("failed_login_count")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at")
  lockedUntil         DateTime? @map("locked_until")
  passwordChangedAt   DateTime? @map("password_changed_at")
  passwordExpiresAt   DateTime? @map("password_expires_at")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")

  userRoles      UserRole[]
  refreshTokens  RefreshToken[]
  demoLinkTokens DemoLinkToken[]
  auditLogs      AuditLog[]
  employee       Employee?
  mfa            UserMfa?
  passwordHistory UserPasswordHistory[]
  devices         UserDevice[]
  loginHistory    UserLoginHistory[]

  inviteToken          String?   @unique @map("invite_token")
  inviteTokenExpiresAt DateTime? @map("invite_token_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([institutionId, email], map: "uq_user_institution_id_email")
  @@map("user")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// USER SECURITY  (PDDS §034 Primary Tables, §136 Authentication & Identity;
// ESS §26 Identity & Credential Security — Phase 4). The ESS and every other
// working document name these categories without ever supplying a numeric
// threshold (checked directly — zero concrete values anywhere in the ESS's
// 170 sections, or in the ECD/EFS/ETAS). The schema below is built straight
// from PDDS §034/§136's real table and column definitions; the *policy*
// values it's enforced against are disclosed OWASP ASVS / NIST 800-63B
// defaults pending your review, not anything sourced from a document.
// ---------------------------------------------------------------------------

enum MfaMethod {
  TOTP // RFC 6238 authenticator app — the only method actually implemented
  SMS // named for completeness; no SMS provider integration exists yet
  EMAIL

  @@schema("nexus")
}

model UserMfa {
  id     String @id(map: "pk_user_mfa") @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_mfa_user")
  userId String @unique @map("user_id")

  method         MfaMethod @default(TOTP)
  secretEncrypted String   @map("secret_encrypted") // TOTP secret, encrypted at rest — never plaintext (ESS §26.5)
  backupCodesHashed String[] @map("backup_codes_hashed") // one-time use, hashed like passwords
  verifiedAt     DateTime? @map("verified_at") // null until the user completes enrollment (scan + confirm code)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@map("user_mfa")
  @@schema("nexus")
}

model UserPasswordHistory {
  id     String @id(map: "pk_user_password_history") @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_password_history_user")
  userId String @map("user_id")

  passwordHash String   @map("password_hash") // same hashing scheme as User.passwordHash, never the live one
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], map: "idx_user_password_history_user_created")
  @@map("user_password_history")
  @@schema("nexus")
}

model UserDevice {
  id     String @id(map: "pk_user_device") @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_device_user")
  userId String @map("user_id")

  fingerprint String  @map("fingerprint") // derived client-side, opaque to the server
  deviceName  String? @map("device_name")
  // "trusted" here means MFA-skip-eligible, not a strong device-identity
  // guarantee — the fingerprint is client-supplied and unattested (no
  // hardware backing), same honesty disclosure as the customer-search
  // ILIKE-vs-trigram gap. Only settable immediately after a device has
  // already completed a full password+MFA login once — trust can never
  // itself be the mechanism that bypasses MFA for the first time.
  trusted     Boolean   @default(false)
  trustedUntil DateTime? @map("trusted_until")
  lastSeenAt  DateTime @map("last_seen_at")
  ipAddress   String? @map("ip_address")
  userAgent   String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([userId, fingerprint], map: "uq_user_device_user_fingerprint")
  @@map("user_device")
  @@schema("nexus")
}

enum LoginResult {
  SUCCESS
  FAILED_PASSWORD
  FAILED_MFA
  LOCKED_OUT
  FAILED_OTHER

  @@schema("nexus")
}

// Deliberately separate from AuditLog: AuditLog is a general mutating-action
// trail (institution-scoped, one row per action string). Lockout counting,
// "new device" detection, and login-pattern queries need a narrow,
// auth-specific table that's fast to query by userId without filtering a
// general-purpose log by action string every time.
model UserLoginHistory {
  id     String @id(map: "pk_user_login_history") @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_login_history_user")
  userId String @map("user_id")

  result        LoginResult
  failureReason String?     @map("failure_reason")
  ipAddress     String?     @map("ip_address")
  userAgent     String?     @map("user_agent")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt], map: "idx_user_login_history_user_created")
  @@map("user_login_history")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// RBAC  (doc §38 User Role Architecture, §39 Permission and Access Control)
// ---------------------------------------------------------------------------

enum RoleCategory {
  EXECUTIVE
  OPERATIONAL
  GOVERNANCE
  TECHNICAL
  CUSTOMER

  @@schema("nexus")
}

model Role {
  id            String       @id(map: "pk_role") @default(uuid())
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_role_institution")
  institutionId String?      @map("institution_id") // null = system/global template role
  name          String
  category      RoleCategory
  description   String?
  isSystem      Boolean      @default(false) @map("is_system") // seeded template vs institution-defined
  // PDDS Phase 4 follow-on — real enforcement, not advisory: a user
  // assigned a role with requireMfa=true cannot obtain a full session
  // without MFA actually verified. See auth.routes.ts login flow and
  // docs/security-policy-defaults.md.
  requireMfa    Boolean      @default(false) @map("require_mfa")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([institutionId, name], map: "uq_role_institution_id_name")
  @@map("role")
  @@schema("nexus")
}

// doc §39.6 — Data / Transaction / Administrative / Reporting / Integration
enum PermissionCategory {
  DATA
  TRANSACTION
  ADMINISTRATIVE
  REPORTING
  INTEGRATION

  @@schema("nexus")
}

// doc §38.9 — View, Create, Update, Delete, Approve, Reject, Export, Configure, Administer, Audit
enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
  CONFIGURE
  ADMINISTER
  AUDIT

  @@schema("nexus")
}

model Permission {
  id          String             @id(map: "pk_permission") @default(uuid())
  code        String             @unique // e.g. "loans.approve", "users.administer"
  category    PermissionCategory
  action      PermissionAction
  resource    String // e.g. "loans", "savings", "users", "reports"
  description String?

  rolePermissions RolePermission[]

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@map("permission")
  @@schema("nexus")
}

model RolePermission {
  id           String     @id(map: "pk_role_permission") @default(uuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "fk_role_permission_role")
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "fk_role_permission_permission")
  permissionId String     @map("permission_id")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([roleId, permissionId], map: "uq_role_permission_role_id_permission_id")
  @@map("role_permission")
  @@schema("nexus")
}

// doc §38.12 — Temporary Delegation: time-limited, auto-expiring role assignment
model UserRole {
  id       String  @id(map: "pk_user_role") @default(uuid())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_role_user")
  userId   String  @map("user_id")
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "fk_user_role_role")
  roleId   String  @map("role_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull, map: "fk_user_role_branch")
  branchId String? @map("branch_id") // resource-level scoping (doc §39.8)

  isDelegated         Boolean   @default(false) @map("is_delegated")
  delegatedFromUserId String?   @map("delegated_from_user_id")
  startsAt            DateTime  @default(now()) @map("starts_at")
  expiresAt           DateTime? @map("expires_at") // null = permanent

  createdAt DateTime @default(now()) @map("created_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([userId, roleId, branchId], map: "uq_user_role_user_id_role_id_branch_id")
  @@map("user_role")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// EMPLOYEE MASTER (doc §50.5 Master Data Domains — "Employee Master:
// Employees, Contract staff, Consultants, Field officers, Executives,
// System users." System access (User) is subordinate to the employee
// record, not the other way around.)
// ---------------------------------------------------------------------------

enum EmploymentStatus {
  ACTIVE
  INACTIVE

  @@schema("nexus")
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  INTERN
  CONSULTANT

  @@schema("nexus")
}

model Employee {
  id            String      @id(map: "pk_employee") @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_employee_institution")
  institutionId String      @map("institution_id")
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull, map: "fk_employee_branch")
  branchId      String?     @map("branch_id")

  employeeNumber   String?        @map("employee_number")
  fullName         String         @map("full_name")
  email            String
  employmentType   EmploymentType @default(PERMANENT) @map("employment_type")
  // doc §50 Master Data Management — normalized lookup tables, replacing
  // what were previously free-text department/position strings. Division
  // stays free-text; only Department/Position were named in the gap.
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, map: "fk_employee_department")
  departmentId     String?     @map("department_id")
  position         Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull, map: "fk_employee_position")
  positionId       String?     @map("position_id")
  division         String?
  grade            String?
  employmentDate   DateTime?      @map("employment_date")
  confirmationDate DateTime?      @map("confirmation_date")

  reportingManager   Employee?  @relation("ReportingLine", fields: [reportingManagerId], references: [id], onDelete: SetNull, map: "fk_employee_reporting_manager")
  reportingManagerId String?    @map("reporting_manager_id")
  directReports      Employee[] @relation("ReportingLine")

  attendanceRecords     AttendanceRecord[]
  performanceReviews     PerformanceReview[]  @relation("EmployeePerformanceReviews")
  performanceReviewsGiven PerformanceReview[] @relation("EmployeePerformanceReviewsGiven")
  disciplinaryCases      DisciplinaryCase[]
  auditFindingsOwned     AuditFinding[]

  status EmploymentStatus @default(ACTIVE)

  // doc §211.2 "Bank File Generation" needs somewhere real to pull an
  // account number from — added here rather than fabricated at export
  // time. Genuinely optional: an employee with no bank details on file
  // simply won't appear in a generated bank file, surfaced as a real,
  // visible gap rather than silently producing an invalid row.
  bankName          String? @map("bank_name")
  bankAccountNumber String? @map("bank_account_number")
  bankAccountName   String? @map("bank_account_name")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, map: "fk_employee_user")
  userId String? @unique @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // PDDS §13.4 Phase 3 — mandatory audit/version/lifecycle columns.
  // created_by/updated_by/version_no auto-populated by Prisma middleware
  // (see lib/requestContext.ts + lib/prisma.ts) so no route handler needs
  // to set them manually. deleted_at/deleted_by are set explicitly by the
  // handful of endpoints that do real disposal. record_status is kept in
  // sync by the same middleware whenever archived/deletedAt change.
  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")
  @@unique([institutionId, email], map: "uq_employee_institution_id_email")
  @@unique([institutionId, employeeNumber], map: "uq_employee_institution_id_employee_number")
  @@map("employee")
  @@schema("nexus")
}

// ---------------------------------------------------------------------------
// HR — ATTENDANCE, PERFORMANCE, DISCIPLINARY (EFS §201 Attendance
// Management, §203 Performance Management; ETAS §41.4 names
// DisciplinaryCase as an owned entity though EFS gives it no detailed
// business rules — built to standard HR disciplinary-case practice
// instead). Ops Supervisor role schedule: "Ensure all Staff report to
// work by 7:30am" (attendance) — the concrete trigger for this gap item.
// §201.2 also names Shift Management and Biometric Integration; neither
// is built — no shift/roster concept exists anywhere in Employee yet,
// and no biometric hardware/SDK integration exists. Both are real,
// disclosed gaps, not silently dropped.
// ---------------------------------------------------------------------------

enum AttendanceMethod {
  MANUAL
  REMOTE // §201.2 Remote Attendance — self-reported, no location verification built

  @@schema("nexus")
}

model AttendanceRecord {
  id            String           @id(map: "pk_attendance_record") @default(uuid())
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade, map: "fk_attendance_record_institution")
  institutionId String           @map("institution_id")
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade, map: "fk_attendance_record_employee")
  employeeId    String           @map("employee_id")

  workDate    DateTime         @map("work_date") // normalized to midnight — one record per employee per day
  clockInAt   DateTime         @map("clock_in_at")
  clockOutAt  DateTime?        @map("clock_out_at")
  method      AttendanceMethod @default(MANUAL)

  // §201.3 "Corrections require approval" — routes through the existing
  // ApprovalRequest system (ATTENDANCE_CORRECTION), same pattern as Cash
  // Balancing variance. The proposed times sit here, unapplied, until
  // approved; clockInAt/clockOutAt above only ever reflect what's
  // actually been approved (or the original clock-in/out if never
  // corrected).
  correctionPending       Boolean   @default(false) @map("correction_pending")
  proposedClockInAt       DateTime? @map("proposed_clock_in_at")
  proposedClockOutAt      DateTime? @map("proposed_clock_out_at")
  correctionReason        String?   @map("correction_reason")
  correctionRequestedById String?   @map("correction_requested_by_id")

  recordedById String   @map("recorded_by_id") // may differ from employeeId's own user — a supervisor can record on someone's behalf
  createdAt    DateTime @default(now()) @map("created_at")

  createdById  String?      @map("created_by_id")
  updatedById  String?      @map("updated_by_id")
  deletedAt    DateTime?    @map("deleted_at")
  deletedById  String?      @map("deleted_by_id")
  versionNo    Int          @default(1) @map("version_no")
  recordStatus RecordStatus @default(ACTIVE) @map("record_status")

  @@unique([employeeId, workDate], map: "uq_attendance_record_employee_work_date")
  @@map("attendance_record")
  @@schema("nexus")
}

enum PerformanceRating {
  UNSATISFACTORY
  NEEDS_IMPROVEMENT
  MEETS_EXPECTATIONS
  EXCEEDS_EXPECTATIONS
  OUTSTANDING

  @@schema("nexus")
}

enum PerformanceReviewStatus {
